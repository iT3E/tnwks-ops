      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(sum by (client) (sum_over_time(wan:client_app_receive_bits:rate2m{client=~\"$client\",category=~\"$category\",app=~\"$app\"}[$__range])) * 15 / 8) + sum(sum by (client) (sum_over_time(wan:client_app_transmit_bits:rate2m{client=~\"$client\",category=~\"$category\",app=~\"$app\"}[$__range])) * 15 / 8)",
