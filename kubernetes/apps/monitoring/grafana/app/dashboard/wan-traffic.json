{
  "uid": "wan-traffic",
  "title": "WAN Traffic (by device, app, destination)",
  "tags": ["network", "wan", "netflow"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "description": "Per-device WAN usage from the RB5009's NetFlow v9 (monitoring/flow-collector), named from DHCP leases (mktxp). App and category are a heuristic from ports and the remote network.",
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(wan:client_app_receive_bits:rate2m, client)",
          "refId": "client-q",
          "qryType": 1
        },
        "definition": "label_values(wan:client_app_receive_bits:rate2m, client)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "category",
        "label": "Category",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(wan:client_app_receive_bits:rate2m, category)",
          "refId": "category-q",
          "qryType": 1
        },
        "definition": "label_values(wan:client_app_receive_bits:rate2m, category)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(wan:client_app_receive_bits:rate2m{category=~\"$category\"}, app)",
          "refId": "app-q",
          "qryType": 1
        },
        "definition": "label_values(wan:client_app_receive_bits:rate2m{category=~\"$category\"}, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1,
        "options": []
      }
    ]
  },
