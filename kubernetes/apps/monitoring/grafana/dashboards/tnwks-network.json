{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tnwks-network"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "About this view",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "Where does the path from the router through FRR/Cilium to a service fail?\n\nMissing or partial evidence is Unknown. [Runbook](https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md)"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "description": "Purpose, scope and the interpretation of missing evidence."
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Site path probes",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "homelab_peer_probe_success{k8s_cluster=~\"$cluster\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bool",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Cross-site probe success from each observer. Read with transport and endpoint evidence; a BGP Established session alone is insufficient.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Site tunnel traffic",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (interface) (rate(mktxp_peer_rx_total{interface=~\"wg-site[0-9]+\"}[5m]))",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "Bps",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Received on the router's WireGuard interface for each site's distro. Missing series mean the router isn't observed, not an idle tunnel.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Router interface errors",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, name) (rate(mktxp_interface_rx_error_total{k8s_cluster=~\"$cluster\"}[5m]))",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Router receive errors by interface. Telemetry enables are integrated after the network migration release.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Path by hop",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "max by (k8s_cluster, hop) (homelab:network_path_state{k8s_cluster=~\"$cluster\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "State"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        },
                        "1": {
                          "text": "Healthy",
                          "color": "#299c46"
                        },
                        "2": {
                          "text": "Degraded",
                          "color": "#e5ac0e"
                        },
                        "3": {
                          "text": "Failed",
                          "color": "#d44a3a"
                        },
                        "4": {
                          "text": "Standby",
                          "color": "#5794f2"
                        },
                        "5": {
                          "text": "Not applicable",
                          "color": "#8e8e8e"
                        },
                        "6": {
                          "text": "Maintenance",
                          "color": "#b877d9"
                        }
                      }
                    }
                  ],
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Per site: the WireGuard tunnel to the router (handshake within 180 s), the router's BGP session with the distro's FRR, and the Cilium agents' sessions with the distro. Unknown when the router or the agents aren't observed.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Routes received per site",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "max by (k8s_cluster) (homelab:router_bgp_prefixes{k8s_cluster=~\"$cluster\"})",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#5794f2"
                  },
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Prefixes the router accepted from each site's FRR (its node, pod and shared-VIP routes). Zero with an established session means the site announces nothing.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Cilium drops",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, reason) (rate(cilium_drop_count_total{k8s_cluster=~\"$cluster\"}[5m]))",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "pps",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Agent drop counters, with bounded labels. Cilium metrics activation belongs to the post-network-release integration.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Mesh connectivity",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "cilium_clustermesh_remote_cluster_readiness_status{k8s_cluster=~\"$cluster\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bool",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Remote cluster readiness from Cilium. Mesh API/KVStoreMesh metrics have separate enabling requirements.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "about"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "fillScreen": false
                }
              },
              "title": "Paths"
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-4"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-5"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-6"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-7"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "fillScreen": false
                }
              },
              "title": "BGP and mesh"
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Dashboards",
        "type": "dashboards",
        "icon": "",
        "tooltip": "",
        "tags": [
          "tnwks"
        ],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "preload": false,
    "tags": [
      "tnwks",
      "l2",
      "network"
    ],
    "timeSettings": {
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0,
      "timezone": "browser"
    },
    "title": "Network & Routing",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "/^(Global|Local|Site 1|Site 2)$/",
          "current": {
            "text": "Global",
            "value": "prometheus-global"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true,
          "label": "Metrics"
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "cluster",
          "query": "homelab-wsl,homelab-wsl-02",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "multi": true,
          "includeAll": true,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false,
          "allValue": ".*",
          "label": "Cluster"
        }
      }
    ],
    "description": "Where does the path from the router through FRR/Cilium to a service fail?",
    "editable": false
  }
}
