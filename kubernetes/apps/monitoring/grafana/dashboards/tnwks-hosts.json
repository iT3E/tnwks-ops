                        "vip": "Shared VIP",
                        "k8s_app": "Component",
                        "component": "Component",
                        "target_cluster": "Remote site",
                        "served_cluster": "Served by",
                        "routerboard_name": "Router",
                        "version": "RouterOS",
                        "name": "Name",
                        "pool": "Pool",
                        "current_firmware": "Installed firmware",
                        "upgrade_firmware": "Available firmware",
                        "host": "Host",
                        "nic": "Adapter",
                        "ap_name": "Access point",
                        "resource": "Resource",
                        "revision": "Revision",
