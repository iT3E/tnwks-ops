                      "renameByName": {
                        "k8s_cluster": "Site",
                        "app": "App",
                        "db_cluster": "Database",
                        "observer_cluster": "Observer",
                        "alertname": "Alert",
                        "severity": "Severity",
                        "workload": "Workload",
                        "tier": "Tier",
                        "engine": "Engine",
                        "cronjob": "Job",
                        "kubernetes_node": "Node",
                        "node": "Node",
                        "hop": "Hop",
                        "vip": "Shared VIP",
                        "k8s_app": "Component",
                        "component": "Component",
                        "target_cluster": "Remote site",
                        "served_cluster": "Served by",
                        "routerboard_name": "Router",
                        "version": "RouterOS",
                        "name": "Name",
                        "pool": "Pool",
                        "current_firmware": "Installed firmware",
                        "upgrade_firmware": "Available firmware",
                        "host": "Host",
                        "nic": "Adapter",
                        "ap_name": "Access point",
                        "resource": "Resource",
                        "revision": "Revision",
                        "app_version": "App version",
                        "chart_version": "Chart",
                        "release_status": "Release",
                        "flux_kind": "Kind",
                        "ready": "Ready",
                        "kernel_version": "Kernel",
                        "kubelet_version": "Kubelet",
                        "os_image": "OS",
                        "volume": "Volume",
                        "collector": "Collector",
                        "slo": "Objective",
                        "Value": "Windows disk free"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Windows disk free"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Runbook",
                            "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "description": "Physical free space remains authoritative even if an ext4 VHDX reports much more virtual space.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Disk temperature",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "smartctl_device_temperature{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "celsius",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "SMART device temperature where published. Missing SMART data is a collection gap, not a passing disk test.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
