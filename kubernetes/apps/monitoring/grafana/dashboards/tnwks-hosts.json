          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#6b6b6b"
                      }
                    ]
                  },
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "State"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "none"
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "0": {
                                "text": "Unknown",
                                "color": "#6b6b6b",
                                "index": 0
                              },
                              "1": {
                                "text": "Healthy",
                                "color": "#1a7f37",
                                "index": 1
                              },
                              "2": {
                                "text": "Degraded",
                                "color": "#e5ac0e",
                                "index": 2
                              },
                              "3": {
                                "text": "Failed",
                                "color": "#c4302b",
                                "index": 3
                              },
                              "4": {
                                "text": "Standby",
                                "color": "#2f6bd0",
                                "index": 4
                              },
                              "5": {
                                "text": "Not applicable",
                                "color": "#6b6b6b",
                                "index": 5
                              },
                              "6": {
                                "text": "Maintenance",
                                "color": "#8a4fb5",
                                "index": 6
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background",
                          "mode": "basic"
                        }
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Runbook",
                            "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "description": "Per warm app: could this site take it over (database, backup, restore drill, fence)? Not applicable where the app runs. Unknown until every prerequisite has evidence. This page does not promise all services fit or fail over.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
