                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "max by (k8s_cluster, app) (homelab:recovery_state{k8s_cluster=~\"$cluster\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}}",
                        "range": false
