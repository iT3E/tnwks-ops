{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tnwks-hosts"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "About this view",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "Can the physical hosts sustain the workload and a site failure?\n\nMissing or partial evidence is Unknown. [Runbook](https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md)"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "description": "Purpose, scope and the interpretation of missing evidence."
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Windows available memory",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "windows_memory_available_bytes{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Physical host availability. Do not add this to WSL MemAvailable, which overlaps the same memory.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Windows disk free",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "windows_logical_disk_free_bytes{k8s_cluster=~\"$cluster\",volume=~\"C:|E:\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Physical free space remains authoritative even if an ext4 VHDX reports much more virtual space.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Disk temperature",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "smartctl_device_temperature{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "celsius",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "SMART device temperature where published. Missing SMART data is a collection gap, not a passing disk test.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Required app replicas",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, app) (homelab_workload_desired_replicas{k8s_cluster=~\"$cluster\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Current placement demand. Full survivor-fit evidence also needs measured requests/peaks, storage placement and pinned hardware.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Recovery readiness",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "max by (k8s_cluster, app) (homelab:recovery_state{k8s_cluster=~\"$cluster\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "State"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        },
                        "1": {
                          "text": "Healthy",
                          "color": "#299c46"
                        },
                        "2": {
                          "text": "Degraded",
                          "color": "#e5ac0e"
                        },
                        "3": {
                          "text": "Failed",
                          "color": "#d44a3a"
                        },
                        "4": {
                          "text": "Standby",
                          "color": "#5794f2"
                        },
                        "5": {
                          "text": "Not applicable",
                          "color": "#8e8e8e"
                        },
                        "6": {
                          "text": "Maintenance",
                          "color": "#b877d9"
                        }
                      }
                    }
                  ],
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-resource-budget.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Readiness remains Unknown until storage/fencing/restore/capacity evidence exists. This page does not promise all services fit or fail over.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "about"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "fillScreen": false
                }
              },
              "title": "Physical resources"
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-4"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-5"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "fillScreen": false
                }
              },
              "title": "Survivor fit"
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Dashboards",
        "type": "dashboards",
        "icon": "",
        "tooltip": "",
        "tags": [
          "tnwks"
        ],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "preload": false,
    "tags": [
      "tnwks",
      "l2",
      "hosts"
    ],
    "timeSettings": {
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0,
      "timezone": "browser"
    },
    "title": "Hosts & Capacity",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "/^(Global|Local|Site 1|Site 2)$/",
          "current": {
            "text": "Global",
            "value": "prometheus-global"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true,
          "label": "Metrics"
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "cluster",
          "query": "homelab-wsl,homelab-wsl-02",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "multi": true,
          "includeAll": true,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false,
          "allValue": ".*",
          "label": "Cluster"
        }
      }
    ],
    "description": "Can the physical hosts sustain the workload and a site failure?",
    "editable": false
  }
}
