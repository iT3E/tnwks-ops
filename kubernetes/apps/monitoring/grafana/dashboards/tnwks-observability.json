{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tnwks-observability"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "About this view",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "Can the other dashboards be trusted, and is monitoring itself sustainable?\n\nMissing or partial evidence is Unknown. [Runbook](https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-dashboard-design.md)"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "description": "Purpose, scope and the interpretation of missing evidence."
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Expected sites",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "count(max by (k8s_cluster) (homelab_expected_site_info))",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#5794f2"
                  },
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Declared inventory survives the disappearance of a source. This is expected scope, not health."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Reporting sites",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "count(homelab:site_reporting == 1) or vector(0)",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#d44a3a"
                      },
                      {
                        "value": 1,
                        "color": "#e5ac0e"
                      },
                      {
                        "value": 2,
                        "color": "#299c46"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "A reporting site has fresh, successful evidence collection. Compare with expected sites; partial results never certify fleet health."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Site evidence",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "max by (k8s_cluster) (homelab:site_state{k8s_cluster=~\"$cluster\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "State"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        },
                        "1": {
                          "text": "Reporting",
                          "color": "#5794f2"
                        }
                      }
                    }
                  ],
                  "links": [
                    {
                      "title": "Diagnose",
                      "url": "/d/tnwks-sites?from=${__from}&to=${__to}&var-cluster=${cluster:percentencode}&var-datasource=${datasource:percentencode}"
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Measured site evidence, including explicit Unknown when an expected site stops reporting. Independent site probes distinguish unreachable from unobserved."
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Evidence age",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "time() - homelab_observer_last_success_timestamp_seconds{k8s_cluster=~\"$cluster\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "links": [
                    {
                      "title": "Diagnose",
                      "url": "/d/tnwks-observability?from=${__from}&to=${__to}&var-cluster=${cluster:percentencode}&var-datasource=${datasource:percentencode}"
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Age of the last successful Kubernetes inventory observation. A recent Prometheus scrape alone does not prove the collector is seeing its upstream."
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Collector source success",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "homelab_collection_success{k8s_cluster=~\"$cluster\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bool",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Collector-specific upstream success. HTTP scrape success can coexist with a blind collector."
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Scrape failures",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, job) (up{k8s_cluster=~\"$cluster\"} == 0)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Discovered failed targets only. Compare with declared inventory to detect targets that disappeared from discovery."
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Active series",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "prometheus_tsdb_head_series{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Head series/churn drive memory and disk growth. Add telemetry in bounded batches before raising resource limits."
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Ingested samples",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "rate(prometheus_tsdb_head_samples_appended_total{k8s_cluster=~\"$cluster\"}[$__rate_interval])",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Ingested samples per second; compare before/after each collector family."
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Retained blocks",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "prometheus_tsdb_storage_blocks_bytes{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Compressed blocks only; WAL/head, metadata and compaction scratch require additional disk."
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Rule evaluation failures",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "rate(prometheus_rule_evaluation_failures_total{k8s_cluster=~\"$cluster\"}[$__rate_interval])",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Local alerts must remain independent of Grafana and the remote archive."
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Archive state",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "homelab:archive_state{k8s_cluster=~\"$cluster\"}",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Unknown",
                          "color": "#8e8e8e"
                        },
                        "1": {
                          "text": "Healthy",
                          "color": "#299c46"
                        },
                        "2": {
                          "text": "Degraded",
                          "color": "#e5ac0e"
                        },
                        "3": {
                          "text": "Failed",
                          "color": "#d44a3a"
                        },
                        "4": {
                          "text": "Standby",
                          "color": "#5794f2"
                        },
                        "5": {
                          "text": "Not applicable",
                          "color": "#8e8e8e"
                        },
                        "6": {
                          "text": "Maintenance",
                          "color": "#b877d9"
                        }
                      }
                    }
                  ],
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Local Garage on WSL-02 only. A loss of this endpoint makes archive history unavailable without invalidating retained local data."
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Unuploaded block age",
