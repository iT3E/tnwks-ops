                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
