                          "color": "#b877d9"
                        }
                      }
                    }
                  ],
                  "links": [
                    {
                      "title": "Diagnose",
                      "url": "/d/tnwks-data?from=${__from}&to=${__to}&var-cluster=${cluster:percentencode}&var-datasource=${datasource:percentencode}"
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Per-app prerequisites. Unknown fencing or untested recovery blocks a positive readiness conclusion. A dashboard never authorizes promotion."
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Archive reachable",
