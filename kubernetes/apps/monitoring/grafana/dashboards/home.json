                    }
                  ],
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "The archive is hosted only on WSL-02. Its failure does not remove local 15-day metrics; older history becomes unavailable."
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Observed state changes",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
