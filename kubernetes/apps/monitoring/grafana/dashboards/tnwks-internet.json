{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tnwks-internet"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "About this view",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "Is the Internet path usable, and is loss/latency or saturation the issue?\n\nMissing or partial evidence is Unknown. [Runbook](https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md)"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "description": "Purpose, scope and the interpretation of missing evidence."
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Internet probe",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "homelab:internet_state{k8s_cluster=~\"$cluster\"}",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background_solid",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Unknown",
                          "color": "#6b6b6b"
                        },
                        "1": {
                          "text": "Healthy",
                          "color": "#1a7f37"
                        },
                        "2": {
                          "text": "Degraded",
                          "color": "#e5ac0e"
                        },
                        "3": {
                          "text": "Failed",
                          "color": "#c4302b"
                        },
                        "4": {
                          "text": "Standby",
                          "color": "#2f6bd0"
                        },
                        "5": {
                          "text": "Not applicable",
                          "color": "#6b6b6b"
                        },
                        "6": {
                          "text": "Maintenance",
                          "color": "#8a4fb5"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#6b6b6b"
                      }
                    ]
                  },
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Observed Internet probe state with freshness/coverage. A working exporter is insufficient.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "WAN p90 latency",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "smokeping:rtt_p90:rate1m{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "p90 over the probe histogram; compare with baseline/threshold and packet loss.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "WAN latency threshold",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "smokeping:latency_threshold:1h{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "The actual recording rule used by the WAN alert, not a separately maintained display threshold.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Packet loss",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "smokeping:loss_ratio:rate1m{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0,
                    "axisSoftMax": 1
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Probe packet loss; distinguish a missing series from zero measured loss.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Download",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "wan:receive_bits:rate1m{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bps",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Measured WAN receive throughput. Current traffic is not the available speed of the connection.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Upload",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "wan:transmit_bits:rate1m{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bps",
                  "links": [
                    {
                      "title": "Open WAN clients",
                      "url": "/d/tnwks-wan-clients/view?from=${__from}&to=${__to}&${cluster:queryparam}&var-datasource=${datasource:percentencode}",
                      "oneClick": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Measured WAN transmit throughput. Who is sending it is on WAN clients.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Top WAN devices now",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "topk(5, sum by (client) (wan:client_app_receive_bits:rate2m) + sum by (client) (wan:client_app_transmit_bits:rate2m))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{client}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "k8s_cluster": 0,
                        "client": 0,
                        "app": 1,
                        "db_cluster": 1
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "app": "App",
                        "db_cluster": "Database",
                        "observer_cluster": "Observer",
                        "alertname": "Alert",
                        "severity": "Severity",
                        "workload": "Workload",
                        "tier": "Tier",
                        "engine": "Engine",
                        "cronjob": "Job",
                        "kubernetes_node": "Node",
                        "node": "Node",
                        "hop": "Hop",
                        "vip": "Shared VIP",
                        "k8s_app": "Component",
                        "component": "Component",
                        "target_cluster": "Remote site",
                        "served_cluster": "Served by",
                        "routerboard_name": "Router",
                        "version": "RouterOS",
                        "name": "Name",
                        "pool": "Pool",
                        "current_firmware": "Installed firmware",
                        "upgrade_firmware": "Available firmware",
                        "host": "Host",
                        "nic": "Adapter",
                        "ap_name": "Access point",
                        "resource": "Resource",
                        "revision": "Revision",
                        "app_version": "App version",
                        "chart_version": "Chart",
                        "release_status": "Release",
                        "flux_kind": "Kind",
                        "ready": "Ready",
                        "kernel_version": "Kernel",
                        "kubelet_version": "Kubelet",
                        "os_image": "OS",
                        "volume": "Volume",
                        "collector": "Collector",
                        "slo": "Objective",
                        "area": "Area",
                        "radio": "Band",
                        "channel": "Channel",
                        "client": "Device",
                        "as_name": "Destination",
                        "category": "Category",
                        "Value": "Traffic"
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "sortBy",
                  "spec": {
                    "options": {
                      "sort": [
                        {
                          "field": "Traffic",
                          "desc": true
                        }
                      ]
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "No traffic seen by flow export",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byType",
                      "options": "string"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "—"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Traffic"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bps"
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open WAN clients",
                            "url": "/d/tnwks-wan-clients/view?from=${__from}&to=${__to}&var-datasource=${datasource:percentencode}&var-client=${__data.fields.client:percentencode}",
                            "oneClick": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "description": "The five devices moving the most Internet traffic now, both directions, from flow export. Click a row for its apps, destinations and history.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "ISP radio collector",
          "links": [
            {
              "title": "Runbook",
              "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/network/architecture.md",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "unms_collector_success{k8s_cluster=~\"$cluster\"}",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "Yes"
                        },
                        "0": {
                          "text": "No"
                        }
                      }
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never"
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Whether the UISP exporter reached its controller. This is collector evidence, not the radio link's own health.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "narrow",
                            "rowHeightMode": "short",
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-1"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 6,
                            "fillScreen": false
                          }
                        },
                        "collapse": false,
                        "hideHeader": true
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "narrow",
                            "rowHeightMode": "standard",
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-2"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-3"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-4"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 2,
                            "fillScreen": false
                          }
                        },
                        "title": "Trends",
                        "collapse": false
                      }
