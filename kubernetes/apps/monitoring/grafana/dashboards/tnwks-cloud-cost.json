                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "noValue": "Unknown — missing evidence"
