                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "(tnwks_aws_budget_actual_usd{k8s_cluster=~\"$cluster\",exported_job=\"aws_budget\"} and ((time() - tnwks_aws_budget_collected_timestamp_seconds{k8s_cluster=~\"$cluster\",exported_job=\"aws_budget\"} < 50400) and (month(tnwks_aws_budget_collected_timestamp_seconds{k8s_cluster=~\"$cluster\",exported_job=\"aws_budget\"}) == scalar(month())))) / (tnwks_aws_budget_limit_usd{k8s_cluster=~\"$cluster\",exported_job=\"aws_budget\"} and ((time() - tnwks_aws_budget_collected_timestamp_seconds{k8s_cluster=~\"$cluster\",exported_job=\"aws_budget\"} < 50400) and (month(tnwks_aws_budget_collected_timestamp_seconds{k8s_cluster=~\"$cluster\",exported_job=\"aws_budget\"}) == scalar(month()))))",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
