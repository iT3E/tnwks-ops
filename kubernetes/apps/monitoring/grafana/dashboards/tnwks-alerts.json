{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tnwks-alerts"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "About this view",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "What is firing now, and can I reach its evidence and runbook?\n\nMissing or partial evidence is Unknown. [Runbook](https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/grafana-dashboard-design.md)"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "description": "Purpose, scope and the interpretation of missing evidence."
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Firing now",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "ALERTS{cluster=~\"$cluster\",alertstate=\"firing\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Current Prometheus firing state, independent of the dashboard historical time selection. Follow the rule's dashboard/runbook annotation for diagnosis."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Pending now",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "ALERTS{cluster=~\"$cluster\",alertstate=\"pending\"}",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 0,
                        "k8s_cluster": 1,
                        "app": 2,
                        "db_cluster": 2
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "db_cluster": "Database",
                        "app": "App",
                        "observer_cluster": "Observer",
                        "Value": "Value"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Pending is not yet firing. Alertmanager silencing/inhibition and notification state are viewed through the per-site Alertmanager links."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Failed notifications",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, integration) (increase(alertmanager_notifications_failed_total{k8s_cluster=~\"$cluster\"}[1h]))",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{app}} {{instance}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "asc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "noValue": "Unknown — missing evidence",
                  "custom": {}
                },
                "overrides": []
              }
            }
          },
          "description": "Failures during the window, not a definitive end-to-end notification receipt check."
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "about"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "fillScreen": false
                }
              },
              "title": "Current"
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "fillScreen": false
                }
              },
              "title": "Delivery"
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Dashboards",
        "type": "dashboards",
        "icon": "",
        "tooltip": "",
        "tags": [
          "tnwks"
        ],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "preload": false,
    "tags": [
      "tnwks",
      "l2",
      "observability"
    ],
    "timeSettings": {
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0,
      "timezone": "browser"
    },
    "title": "Alerts",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "/^(Global|Local|Site 1|Site 2)$/",
          "current": {
            "text": "Global",
            "value": "prometheus-global"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true,
          "label": "Metrics"
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "cluster",
          "query": "homelab-wsl,homelab-wsl-02",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "multi": true,
          "includeAll": true,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false,
          "allValue": ".*",
          "label": "Cluster"
        }
      }
    ],
    "description": "What is firing now, and can I reach its evidence and runbook?",
    "editable": false
  }
}
