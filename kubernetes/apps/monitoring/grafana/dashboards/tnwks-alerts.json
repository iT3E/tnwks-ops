{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tnwks-alerts"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "About this view",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "What is firing now, and can I reach its evidence and runbook?\n\nMissing or partial evidence is Unknown. [Runbook](https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md)"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "description": "Purpose, scope and the interpretation of missing evidence."
        }
      },
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Firing now",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "label_replace(max by (cluster, alertname, severity) (ALERTS{cluster=~\"$cluster\",alertstate=\"firing\",severity!=\"none\"}), \"k8s_cluster\", \"$1\", \"cluster\", \"(.+)\")",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{cluster}} {{alertname}} {{severity}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true,
                        "Value": true
                      },
                      "indexByName": {
                        "k8s_cluster": 0,
                        "client": 0,
                        "app": 1,
                        "db_cluster": 1
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "app": "App",
                        "db_cluster": "Database",
                        "observer_cluster": "Observer",
                        "alertname": "Alert",
                        "severity": "Severity",
                        "workload": "Workload",
                        "tier": "Tier",
                        "engine": "Engine",
                        "cronjob": "Job",
                        "kubernetes_node": "Node",
                        "node": "Node",
                        "hop": "Hop",
                        "vip": "Shared VIP",
                        "k8s_app": "Component",
                        "component": "Component",
                        "target_cluster": "Remote site",
                        "served_cluster": "Served by",
                        "routerboard_name": "Router",
                        "version": "RouterOS",
                        "name": "Name",
                        "pool": "Pool",
                        "current_firmware": "Installed firmware",
                        "upgrade_firmware": "Available firmware",
                        "host": "Host",
                        "nic": "Adapter",
                        "ap_name": "Access point",
                        "resource": "Resource",
                        "revision": "Revision",
                        "app_version": "App version",
                        "chart_version": "Chart",
                        "release_status": "Release",
                        "flux_kind": "Kind",
                        "ready": "Ready",
                        "kernel_version": "Kernel",
                        "kubelet_version": "Kubelet",
                        "os_image": "OS",
                        "volume": "Volume",
                        "collector": "Collector",
                        "slo": "Objective",
                        "area": "Area",
                        "radio": "Band",
                        "channel": "Channel",
                        "client": "Device",
                        "as_name": "Destination",
                        "category": "Category"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "None",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byType",
                      "options": "string"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "—"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Site"
                    },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Runbook",
                            "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "description": "Current Prometheus firing state, independent of the dashboard historical time selection, excluding heartbeats. Follow the rule's dashboard/runbook annotation for diagnosis.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Pending now",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "label_replace(max by (cluster, alertname, severity) (ALERTS{cluster=~\"$cluster\",alertstate=\"pending\",severity!=\"none\"}), \"k8s_cluster\", \"$1\", \"cluster\", \"(.+)\")",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{cluster}} {{alertname}} {{severity}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "__name__": true,
                        "Time": true,
                        "__replica__": true,
                        "alertstate": true,
                        "cluster": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "kind": true,
                        "namespace": true,
                        "observer_cluster": true,
                        "pod": true,
                        "prometheus": true,
                        "service": true,
                        "Value": true
                      },
                      "indexByName": {
                        "k8s_cluster": 0,
                        "client": 0,
                        "app": 1,
                        "db_cluster": 1
                      },
                      "renameByName": {
                        "k8s_cluster": "Site",
                        "app": "App",
                        "db_cluster": "Database",
                        "observer_cluster": "Observer",
                        "alertname": "Alert",
                        "severity": "Severity",
                        "workload": "Workload",
                        "tier": "Tier",
                        "engine": "Engine",
                        "cronjob": "Job",
                        "kubernetes_node": "Node",
                        "node": "Node",
                        "hop": "Hop",
                        "vip": "Shared VIP",
                        "k8s_app": "Component",
                        "component": "Component",
                        "target_cluster": "Remote site",
                        "served_cluster": "Served by",
                        "routerboard_name": "Router",
                        "version": "RouterOS",
                        "name": "Name",
                        "pool": "Pool",
                        "current_firmware": "Installed firmware",
                        "upgrade_firmware": "Available firmware",
                        "host": "Host",
                        "nic": "Adapter",
                        "ap_name": "Access point",
                        "resource": "Resource",
                        "revision": "Revision",
                        "app_version": "App version",
                        "chart_version": "Chart",
                        "release_status": "Release",
                        "flux_kind": "Kind",
                        "ready": "Ready",
                        "kernel_version": "Kernel",
                        "kubelet_version": "Kubelet",
                        "os_image": "OS",
                        "volume": "Volume",
                        "collector": "Collector",
                        "slo": "Objective",
                        "area": "Area",
                        "radio": "Band",
                        "channel": "Channel",
                        "client": "Device",
                        "as_name": "Destination",
                        "category": "Category"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": [],
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "None",
                  "custom": {
                    "align": "auto",
                    "inspect": false,
                    "minWidth": 70
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byType",
                      "options": "string"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "—"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Site"
                    },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Runbook",
                            "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "description": "Pending is not yet firing. Alertmanager silencing/inhibition and notification state are viewed through the per-site Alertmanager links.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Alerts in Alertmanager",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, state) (alertmanager_alerts{k8s_cluster=~\"$cluster\"})",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{state}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Alerts each site's Alertmanager holds: active, or suppressed by a silence or inhibition. Compare with Firing now: an alert firing in Prometheus but missing here never reached Alertmanager.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Active silences",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "max by (k8s_cluster) (alertmanager_silences{k8s_cluster=~\"$cluster\",state=\"active\"})",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Silences in force. A forgotten silence hides real alerts; check each one has an end time and a reason.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Configuration loaded",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "min by (k8s_cluster) (alertmanager_config_last_reload_successful{k8s_cluster=~\"$cluster\"})",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "Loaded"
                        },
                        "0": {
                          "text": "Failed"
                        }
                      }
                    }
                  ],
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Whether each Alertmanager's last configuration reload succeeded. A failed reload keeps the previous routes and receivers.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Notifications sent",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster, integration) (increase(alertmanager_notifications_total{k8s_cluster=~\"$cluster\"}[1h]))",
                        "instant": false,
                        "legendFormat": "{{k8s_cluster}} {{integration}}",
                        "range": true
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/observability-implementation.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence",
                  "custom": {
                    "lineWidth": 1,
                    "showPoints": "never",
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          },
          "description": "Notification attempts per integration in the last hour.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Failed notifications",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (k8s_cluster) (increase(alertmanager_notifications_failed_total{k8s_cluster=~\"$cluster\"}[$__range]))",
                        "instant": true,
                        "legendFormat": "{{k8s_cluster}}",
                        "range": false
                      },
                      "datasource": {
                        "name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "text"
                      },
                      {
                        "value": 1,
                        "color": "#c4302b"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "links": [
                    {
                      "title": "Runbook",
                      "url": "https://github.com/iT3E/tnwks-ops/blob/main/docs/operations/external-monitoring.md",
                      "targetBlank": true
                    }
                  ],
                  "noValue": "Unknown — missing evidence"
                },
                "overrides": []
              }
            }
          },
          "description": "Delivery failures, not a definitive end-to-end notification receipt check. Counted over the selected range, per site; anything but zero is red.\n\nObservation budget: 180s for current evidence; backup/restore objectives and historical windows are separate. Source contract: observability/generated/panel-contracts.json."
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "narrow",
                            "rowHeightMode": "standard",
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-1"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-2"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 2,
                            "fillScreen": false
                          }
                        },
                        "collapse": false,
                        "hideHeader": true
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "narrow",
                            "rowHeightMode": "short",
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "about"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 1,
                            "fillScreen": false
                          }
                        },
                        "title": "About this view",
                        "collapse": true
                      }
                    }
                  ]
                }
              },
              "title": "Current"
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "narrow",
                            "rowHeightMode": "short",
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
