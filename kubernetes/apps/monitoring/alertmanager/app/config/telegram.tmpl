{{/*
  Telegram (parse_mode HTML) message for the War Room.

  Every alert line carries the labels that tell alerts apart (rule_group,
  pod, instance, ...), plus runbook, dashboard and graph links, so a grouped
  "FIRING:2" no longer shows two identical lines. The dashboard link opens on
  the incident: from an hour before it started to now, or to 15 minutes after
  it resolved. An alert without a dashboard_url (the charts' own rules) links
  to the Alerts board for the site that raised it, at Grafana's address next
  to Alertmanager's external URL.

  Flux events (flux-system/addons/alerts) carry their error text in the
  `message` annotation, so that is the last fallback for the alert line.

  Rendered with: amtool template render --template.glob=telegram.tmpl \
    --template.text='{{ template "telegram.message" . }}'
*/}}

{{ define "telegram.message" -}}
{{ if eq .Status "firing" }}🔥{{ else }}✅{{ end }} <b>{{ .Status | toUpper }}{{ if eq .Status "firing" }} ({{ .Alerts.Firing | len }}){{ end }}: {{ .CommonLabels.alertname }}</b>{{ with .CommonLabels.severity }} [{{ . }}]{{ end }}
{{- with .CommonAnnotations.summary }}
<i>{{ . }}</i>
{{- end }}
{{ range $i, $a := .Alerts }}{{ if lt $i 8 }}
• {{ with $a.Annotations.description }}{{ . }}{{ else }}{{ with $a.Annotations.summary }}{{ . }}{{ else }}{{ with $a.Annotations.message }}{{ . }}{{ end }}{{ end }}{{ end }}
{{ template "telegram.labels" $a }}
{{- if $a.Annotations.runbook_url }} <a href="{{ $a.Annotations.runbook_url }}">runbook</a>{{ end }}
{{- if $a.Annotations.dashboard_url }} <a href="{{ $a.Annotations.dashboard_url }}{{ template "telegram.range" $a }}">dashboard</a>
{{- else if and $a.Labels.cluster (match "^https://alertmanager\\." $.ExternalURL) }} <a href="{{ reReplaceAll "^https://alertmanager\\." "https://grafana." $.ExternalURL }}/d/tnwks-alerts?var-cluster={{ $a.Labels.cluster }}{{ template "telegram.range" $a }}">alerts</a>{{ end }}{{ if $a.GeneratorURL }} <a href="{{ $a.GeneratorURL }}">graph</a>{{ end }}
{{ end }}{{ end -}}
{{ if gt (len .Alerts) 8 }}
…and {{ len .Alerts | printf "%d" }} total, see Alertmanager.
{{- end }}
{{- end }}

{{/* The incident's time range: an hour before it started, to now or 15 minutes after it resolved. */}}
{{ define "telegram.range" -}}
&from={{ (.StartsAt.Add -3600000000000).UnixMilli }}&to={{ if eq .Status "resolved" }}{{ (.EndsAt.Add 900000000000).UnixMilli }}{{ else }}now{{ end }}
{{- end }}

{{/* Distinguishing labels only. rule_group paths are trimmed to the group name. */}}
{{ define "telegram.labels" -}}
<code>{{ range (.Labels.Remove (stringSlice "alertname" "severity" "prometheus" "container" "endpoint" "service" "job" "uid")).SortedPairs }}{{ .Name }}={{ reReplaceAll "^.*;" "" .Value }} {{ end }}</code>
{{- end }}
