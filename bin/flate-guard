#!/usr/bin/env bash
# Run flate with a hang guard, for CI. Arguments pass straight to flate;
# stdout is flate's stdout.
#
#   bin/flate-guard test all --no-progress -p kubernetes/clusters/wsl
#
# flate sometimes hangs in CI with no output: the cluster renders took 1-10 s,
# then one sat until the 5-minute step timeout (15 times in 790 runs,
# 2026-11-05..07), ignored SIGQUIT and was killed. Locally it never
# reproduced. So each attempt is capped at RENDER_TIMEOUT (default 2m) and
# retried up to RENDER_ATTEMPTS times (default 2). Before a hung attempt is
# killed, this prints what it was doing: the flate process tree with state and
# wait channel, memory, the tail of flate's debug log (which names every
# source fetch as it starts and finishes) and, if SIGQUIT works, the goroutine
# stacks.
#
# flate runs at --log-level debug with stderr to a file. When it ends on its
# own, the non-debug lines of that file go to stderr as usual.
set -uo pipefail

timeout_s="${RENDER_TIMEOUT:-2m}"
attempts="${RENDER_ATTEMPTS:-2}"
case "${timeout_s}" in
  *m) limit=$(( ${timeout_s%m} * 60 )) ;;
  *s) limit="${timeout_s%s}" ;;
  *) limit="${timeout_s}" ;;
esac

log_dir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/flate-guard"
mkdir -p "${log_dir}"

diagnose() {  # PID LOG
  local pid="$1" log="$2" kids
  echo "::group::flate-guard diagnostics (pid ${pid})" >&2
  kids="$(pgrep -d, -P "${pid}" || true)"
  ps -o pid,ppid,stat,wchan:32,etime,rss,args -p "${pid}${kids:+,${kids}}" >&2 || true
  grep -E '^(State|Threads|VmRSS|voluntary_ctxt_switches|nonvoluntary_ctxt_switches):' "/proc/${pid}/status" >&2 2>/dev/null || true
  uptime >&2 || true
  free -m >&2 || true
  echo "--- last 40 debug lines" >&2
  grep -v "commonLabels" "${log}" | tail -n 40 | cut -c1-300 >&2
  echo "::endgroup::" >&2
}

rc=1
for attempt in $(seq 1 "${attempts}"); do
  log="${log_dir}/attempt-$$-${attempt}.log"
  flate "$@" --log-level debug 2>"${log}" &
  pid=$!
  waited=0
  while kill -0 "${pid}" 2>/dev/null && (( waited < limit )); do
    sleep 1
    waited=$(( waited + 1 ))
  done
  if ! kill -0 "${pid}" 2>/dev/null; then
    wait "${pid}"
    rc=$?
    grep -v ' level=DEBUG ' "${log}" >&2
    exit "${rc}"
  fi
  echo "::warning::flate $* hung for ${timeout_s} (attempt ${attempt} of ${attempts})" >&2
  diagnose "${pid}" "${log}"
  kill -QUIT "${pid}" 2>/dev/null || true
  for _ in $(seq 1 20); do kill -0 "${pid}" 2>/dev/null || break; sleep 1; done
  if kill -0 "${pid}" 2>/dev/null; then
    echo "flate ignored SIGQUIT for 20 s; killing it" >&2
    pkill -KILL -P "${pid}" 2>/dev/null || true
    kill -KILL "${pid}" 2>/dev/null || true
  fi
  wait "${pid}" 2>/dev/null
  echo "::group::flate goroutine stacks (attempt ${attempt})" >&2
  sed -n '/^goroutine /,$p' "${log}" | head -n 400 >&2
  echo "::endgroup::" >&2
  rc=124
done
echo "::error::flate $* hung on every attempt (${attempts} x ${timeout_s})" >&2
exit "${rc}"
