#!/usr/bin/env python3
"""Move an app between the WSL sites: a planned switchover (docs/wsl/multi-site.md).

    site-failover status APP
    site-failover switchover APP --to SITE [--yes] [--skip-pvcs]
    site-failover switchover APP --to SITE --promote [--yes]   (old site dead)
    site-failover clear APP [--yes]

What a switchover does, old site -> new site, through each site's
`flux-system/site-overrides` ConfigMap (Flux's last substituteFrom source; git
stays the default and Flux is still the only thing that applies manifests):

  1. preflight: both Postgres clusters healthy, old primary, new replica,
     WAL replay caught up to the old site's archive; peer repo Ready
  2. old: <P>_REPLICAS=0 (and the backup schedule suspended); wait until the
     app's pods are gone
  3. each PVC: one-off kopiur Snapshot on the old site, Restore on the new
     site from the old site's repository (read-only peer ClusterRepository)
  4. old: <P>_PG_PRIMARY=new; wait for the demotion token
  5. new: <P>_PG_PRIMARY=new + <P>_PG_PROMOTION_TOKEN + <P>_REPLICAS=1 (+
     schedule on); wait for the primary, then the app
  6. check the app from inside its pod; print the timings (RTO, RPO)

Each app's keys are written with their own server-side-apply field manager
(site-failover-<app>), so apps don't overwrite each other's overrides. `clear`
removes an app's keys (and the ConfigMap once it's empty): run it only after
git says the same thing (a PR to cluster-settings), or the app falls back to
git's defaults.

--promote is the unplanned path (docs/wsl/multi-site.md, "Fencing"): the old
site is dead or unreachable. It runs only when the app's site lease
(<app>.lease.tnwks.local, set by a PR to dns-sites.tf) already fences the old
site, never touches the old site, restores each PVC from the old site's
newest kopiur snapshot (in S3), and promotes the new site without a token:
data written after the old site's last archived WAL is lost. The old site's
app gate and database fence keep it from writing when it returns.

Reaching the sites: kubectl and flux run locally with
~/.kube/config-<site>, or, when FAILOVER_SSH_<SITE> is set (site name upper
case, '-' -> '_', e.g. FAILOVER_SSH_HOMELAB_WSL_02="user@host -p 2222"), on
that host over SSH with its ~/.kube/config-<site>.
"""
import argparse
import base64
import json
import os
import random
import shlex
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path

SITES = ("homelab-wsl", "homelab-wsl-02")
# Each site's top-level Flux Kustomization: it applies cluster-settings, the
# values an app falls back to once its overrides are gone.
TOP_KS = {"homelab-wsl": "cluster-apps", "homelab-wsl-02": "cluster-apps-wsl-02"}
REMOTE_PATH = "/opt/tnwks-tools/bin"
APPS_FILE = Path(__file__).with_name("site-failover-apps.json")


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def die(msg):
    log(f"ERROR: {msg}")
    sys.exit(1)


class Site:
    def __init__(self, name):
        self.name = name
        env = "FAILOVER_SSH_" + name.upper().replace("-", "_")
        self.ssh = shlex.split(os.environ[env]) if os.environ.get(env) else None
        self.kubeconfig = os.environ.get(
            "FAILOVER_KUBECONFIG_" + name.upper().replace("-", "_"),
            f"~/.kube/config-{name}",
        )

    def run(self, argv, stdin=None, check=True, timeout=900):
        if self.ssh:
            remote = (
                f"export PATH=$PATH:{REMOTE_PATH} KUBECONFIG={self.kubeconfig}; "
                + " ".join(shlex.quote(a) for a in argv)
            )
            cmd = ["ssh", "-o", "BatchMode=yes", *self.ssh, remote]
            env = None
        else:
            cmd = argv
            env = dict(os.environ, KUBECONFIG=os.path.expanduser(self.kubeconfig))
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, env=env, timeout=timeout)
        if check and p.returncode != 0:
            die(f"{self.name}: {' '.join(argv)}: {p.stderr.strip() or p.stdout.strip()}")
        return p

    def kubectl(self, *args, **kw):
        return self.run(["kubectl", *args], **kw)

    def get(self, kind, name, ns, check=True):
        p = self.kubectl("get", kind, name, "-n", ns, "-o", "json", check=False)
        if p.returncode != 0:
            if check:
                die(f"{self.name}: {kind} {ns}/{name}: {p.stderr.strip()}")
            return None
        return json.loads(p.stdout)

    def reconcile(self, ks, timeout="15m"):
        if isinstance(ks, list):
            for k in ks:
                self.reconcile(k, timeout)
            return
        log(f"{self.name}: flux reconcile ks {ks}")
        p = self.run(["flux", "reconcile", "ks", ks, "-n", "flux-system", f"--timeout={timeout}"], check=False, timeout=1200)
        if p.returncode != 0:
            log(f"{self.name}: reconcile {ks} didn't finish cleanly ({p.stderr.strip()[-200:]}); carrying on and checking state")

    def psql(self, pod, sql, db="postgres"):
        p = self.kubectl("exec", "-n", "databases", pod, "-c", "postgres", "--", "psql", "-d", db, "-tAc", sql, check=False)
        return p.stdout.strip() if p.returncode == 0 else None

    # --- site-overrides ---------------------------------------------------
    def overrides(self):
        cm = self.get("configmap", "site-overrides", "flux-system", check=False)
        return (cm or {}).get("data") or {}

    def set_overrides(self, app, data):
        cm = {
            "apiVersion": "v1",
            "kind": "ConfigMap",
            "metadata": {"name": "site-overrides", "namespace": "flux-system"},
            "data": data,
        }
        log(f"{self.name}: site-overrides[{app}] = {data}")
        self.kubectl(
            "apply", "--server-side", f"--field-manager=site-failover-{app}", "--force-conflicts", "-f", "-",
            stdin=json.dumps(cm),
        )
        if not self.overrides() and self.get("configmap", "site-overrides", "flux-system", check=False):
            log(f"{self.name}: site-overrides is empty; deleting it")
            self.kubectl("delete", "configmap", "site-overrides", "-n", "flux-system", "--ignore-not-found")


def lease(app_name):
    """The app's site lease (TXT <app>.lease.tnwks.local), or None if unreadable."""
    ns = "10.10.91.1"
    try:
        with open("/etc/resolv.conf") as f:
            ns = next((l.split()[1] for l in f if l.startswith("nameserver")), ns)
    except OSError:
        pass
    qid = random.randint(0, 0xFFFF)
    q = struct.pack(">HHHHHH", qid, 0x0100, 1, 0, 0, 0)
    for label in f"{app_name}.lease.tnwks.local".split("."):
        q += bytes([len(label)]) + label.encode()
    q += b"\x00" + struct.pack(">HH", 16, 1)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(3)
    try:
        s.sendto(q, (ns, 53))
        r, _ = s.recvfrom(4096)
    except OSError:
        return None
    finally:
        s.close()
    rid, flags, qd, an = struct.unpack(">HHHH", r[:8])
    if rid != qid or flags & 0x000F:
        return None
    off = 12
    for _ in range(qd):
        while r[off]:
            off += r[off] + 1
        off += 5
    for _ in range(an):
        if r[off] & 0xC0 == 0xC0:
            off += 2
        else:
            while r[off]:
                off += r[off] + 1
            off += 1
        rtype, _, _, rdlen = struct.unpack(">HHIH", r[off:off + 10])
        off += 10
        if rtype == 16 and rdlen:
            return r[off + 1:off + 1 + r[off]].decode()
        off += rdlen
    return None


def wait(what, fn, timeout=900, every=10):
    start = time.time()
    while time.time() - start < timeout:
        v = fn()
        if v:
            return v
        time.sleep(every)
    raise RuntimeError(f"timed out after {timeout}s waiting for {what}")


def load_app(name):
    apps = json.loads(APPS_FILE.read_text())
    if name not in apps or name.startswith("_"):
        die(f"unknown app {name!r}; known: {', '.join(k for k in apps if not k.startswith('_'))}")
    return apps[name]


def pg_list(app):
    """The app's Postgres clusters as [(cluster, variable prefix)]. "postgres" is a
    cluster name (prefix = the app's) or a list of {cluster, prefix} that switch together."""
    pg = app.get("postgres")
    if not pg:
        return []
    if isinstance(pg, str):
        return [(pg, app["prefix"])]
    return [(d["cluster"], d["prefix"]) for d in pg]


def pg_state(site, app, cluster=None):
    if not app.get("postgres"):
        return None
    cluster = cluster or pg_list(app)[0][0]
    c = site.get("cluster.postgresql.cnpg.io", cluster, "databases", check=False)
    if not c:
        return None
    st = c.get("status", {})
    pod = st.get("currentPrimary") or st.get("targetPrimary")
    rec = site.psql(pod, "select pg_is_in_recovery()") if pod else None
    return {
        "phase": st.get("phase"),
        "pod": pod,
        "in_recovery": rec == "t",
        "primary": c["spec"].get("replica", {}).get("primary"),
        "demotion_token": st.get("demotionToken"),
    }


def workloads(app):
    """["deployment/x", "statefulset/y", ...]; plain names in "deployments" are Deployments."""
    return app.get("workloads") or [f"deployment/{d}" for d in app.get("deployments", [])]


def deployments_stopped(site, app):
    for w in workloads(app):
        kind, name = w.split("/", 1)
        o = site.get(kind, name, app["namespace"], check=False)
        if o and (o["spec"].get("replicas", 1) != 0 or o.get("status", {}).get("replicas", 0) != 0):
            return False
    return True


def deployments_ready(site, app):
    for w in workloads(app):
        kind, name = w.split("/", 1)
        o = site.get(kind, name, app["namespace"], check=False)
        if not o or o["spec"].get("replicas", 0) < 1:
            return False
        if o.get("status", {}).get("readyReplicas", 0) < o["spec"]["replicas"]:
            return False
    return True


def reconcile_backup(site, app):
    # The backup schedule (<P>_BACKUP_SUSPEND) lives in another Kustomization
    # (kopiur-policies); without this it follows the override only at its
    # next interval.
    if app.get("backup_schedule") and app["kustomizations"].get("backup"):
        site.reconcile(app["kustomizations"]["backup"], timeout="5m")


# --- commands -------------------------------------------------------------
def cmd_status(args):
    app = load_app(args.app)
    p = app["prefix"]
    for s in map(Site, SITES):
        ov = {k: v for k, v in s.overrides().items() if k.split("_")[0] in {pp.split("_")[0] for pp in [p] + [x for _, x in pg_list(app)]}}
        pgs = [(cl, pg_state(s, app, cl) or {}) for cl, _ in pg_list(app)]
        deps = []
        for w in workloads(app):
            kind, d = w.split("/", 1)
            o = s.get(kind, d, app["namespace"], check=False)
            deps.append(f"{d}={o['status'].get('readyReplicas', 0)}/{o['spec'].get('replicas')}" if o else f"{d}=absent")
        print(f"{s.name}:")
        print(f"  overrides: {ov or '{}'}")
        for cl, pg in pgs:
            print(f"  {cl}:  {pg.get('phase')} primary={pg.get('primary')} in_recovery={pg.get('in_recovery')} pod={pg.get('pod')}")
        print(f"  app:       {' '.join(deps)}")


def check_lease(app_name, old, new, promote):
    # Fencing (docs/wsl/multi-site.md): planned switchovers need an unfenced
    # app; an unplanned promote needs the old site fenced first.
    ls = lease(app_name)
    log(f"site lease {app_name}.lease.tnwks.local: {ls!r}")
    if ls is None:
        die("the site lease can't be read (router DNS); the app gate would block the new site too")
    if ls == new.name:
        die(f"{new.name} is fenced from writing {app_name}; its app would wait at the gate")
    if promote and ls != old.name:
        die(f"--promote needs the lease to fence {old.name} first: set site_leases.{app_name} = "
            f"\"{old.name}\" in infrastructure/terraform/environments/prod/mikrotik/dns-sites.tf and let it apply")
    if not promote and ls == old.name:
        die(f"{old.name} is fenced (an unplanned failover happened): rebuild it before a planned switchover")


def preflight(old, new, app):
    for cl, _ in pg_list(app):
        preflight_pg(old, new, app, cl)
    preflight_pvcs(new, old, app)
    return None, None


def preflight_pg(old, new, app, cl):
    po, pn = pg_state(old, app, cl), pg_state(new, app, cl)
    if not po or not pn:
        die(f"{cl} missing on {'old' if not po else 'new'} site")
    if po["in_recovery"] or pn["in_recovery"] is False:
        die(f"{cl}: expected {old.name} primary and {new.name} replica; got old in_recovery={po['in_recovery']}, new in_recovery={pn['in_recovery']}")
    for s, st in ((old, po), (new, pn)):
        if st["phase"] != "Cluster in healthy state":
            die(f"{s.name}: {cl} is {st['phase']!r}")
    # The replica replays the old site's archive (WAL-only for now), so it
    # should have reached the start of the last archived segment. The promotion
    # waits for the token's LSN anyway; this only catches a stuck replica early.
    archived = old.psql(po["pod"], "select last_archived_wal from pg_stat_archiver")
    replayed = new.psql(pn["pod"], "select pg_last_wal_replay_lsn()")
    log(f"{cl} WAL: {old.name} last archived {archived}, {new.name} replayed to {replayed}")
    if archived and replayed and len(archived) >= 24:
        seg_start = (int(archived[8:16], 16) << 32) | (int(archived[16:24], 16) * 0x1000000)
        hi, lo = replayed.split("/")
        if ((int(hi, 16) << 32) | int(lo, 16)) < seg_start:
            die(f"{new.name} hasn't replayed {archived} of {cl} yet; wait for it (or check the replica)")


def preflight_pvcs(new, old, app):
    if app["pvcs"]:
        repo = new.kubectl("get", "clusterrepository.kopiur.home-operations.com", old.name, "-o", "json", check=False)
        if repo.returncode != 0:
            die(f"{new.name}: no ClusterRepository {old.name} (kopiur peer repository)")
        conds = {c["type"]: c["status"] for c in json.loads(repo.stdout).get("status", {}).get("conditions", [])}
        if conds.get("Ready") != "True":
            die(f"{new.name}: ClusterRepository {old.name} not Ready")


def restore_mover(pvc):
    # restore_privileged: kopiur's privilegedMode (root with the file
    # capabilities). A mover that's only uid 0 has every capability dropped and
    # can't read or delete another user's private files (sonarr's Backups/,
    # written during the prebind). The namespace must allow privileged movers.
    if pvc.get("restore_privileged"):
        return {"privilegedMode": True}
    return {"securityContext": {"runAsUser": pvc.get("restore_uid", pvc["uid"]), "runAsGroup": pvc.get("restore_uid", pvc["gid"])}}


def restore_target(site, app, pvc):
    # A StatefulSet's PVC doesn't exist until its pod does: kopiur creates it
    # (same name), and the StatefulSet adopts it when it scales up.
    if pvc.get("create") and not site.get("persistentvolumeclaim", pvc["name"], app["namespace"], check=False):
        c = pvc["create"]
        sc = c["storageClass"][site.name] if isinstance(c["storageClass"], dict) else c["storageClass"]
        return {"pvc": {"name": pvc["name"], "capacity": c["capacity"], "storageClassName": sc,
                        "accessModes": ["ReadWriteOnce"]}}
    return {"pvcRef": {"name": pvc["name"]}}


def prebind(site, app, name):
    """local-path binds a PVC to the node of its first consumer. Restore movers
    land anywhere, so an app whose pods share a PVC (the media stack) ended up
    with its PVCs on two nodes and pods that could never schedule (2026-11-06).
    Start the app here briefly so the scheduler binds every PVC together (the
    first pod pins the shared one, the rest follow it), then stop it: the
    restores then run where the PVCs are, and their exact mirror replaces
    whatever the app wrote meanwhile."""
    log(f"{site.name}: prebinding {name}'s PVCs (start it once, then stop it)")
    p = app["prefix"]
    site.set_overrides(name, {f"{p}_REPLICAS": "1"})
    site.reconcile(app["kustomizations"]["app"])

    def bound():
        out = site.kubectl("get", "pvc", "-n", app["namespace"], "-o", "json").stdout
        phases = {i["metadata"]["name"]: i["status"].get("phase") for i in json.loads(out)["items"]}
        want = [v["name"] for v in app["pvcs"]] + app.get("prebind_extra", [])
        return all(phases.get(n) == "Bound" for n in want)
    wait(f"{name}'s PVCs bound on {site.name}", bound, timeout=900)
    site.set_overrides(name, {f"{p}_REPLICAS": "0"})
    site.reconcile(app["kustomizations"]["app"])
    wait(f"{name} stopped again on {site.name}", lambda: deployments_stopped(site, app), timeout=600)
    log(f"{site.name}: {name}'s PVCs are bound; copying")


def copy_pvc(old, new, app, pvc, stamp):
    ns = app["namespace"]
    snap = f"{pvc['policy']}-switchover-{stamp}"
    log(f"{old.name}: Snapshot {ns}/{snap} (policy {pvc['policy']})")
    old.kubectl("create", "-f", "-", stdin=json.dumps({
        "apiVersion": "kopiur.home-operations.com/v1alpha1",
        "kind": "Snapshot",
        "metadata": {"name": snap, "namespace": ns},
        "spec": {
            "policyRef": {"name": pvc["policy"]},
            "description": f"site-failover {app['prefix'].lower()} -> {new.name}",
            "deletionPolicy": "Delete",
        },
    }))

    def snapped():
        o = old.get("snapshot.kopiur.home-operations.com", snap, ns)
        st = o.get("status", {})
        ph = st.get("phase")
        if ph == "Failed":
            raise RuntimeError(f"{old.name}: Snapshot {snap} failed: {st.get('logTail', '')[-300:]}")
        # A condition that can't clear by itself (e.g. MoverPermitted=False):
        # fail now instead of at the timeout.
        for c in st.get("conditions", []):
            if c.get("type") in ("MoverPermitted",) and c.get("status") == "False":
                raise RuntimeError(f"{old.name}: Snapshot {snap}: {c.get('reason')}: {c.get('message', '')[:300]}")
        return o if ph == "Succeeded" else None

    # Big PVCs upload to S3 first (Immich's library is 2.5 GB): allow an hour.
    o = wait(f"Snapshot {snap}", snapped, timeout=3600, every=15)
    ident = o["status"]["snapshot"]["identity"]
    sid = o["status"]["snapshot"]["kopiaSnapshotID"]
    log(f"{old.name}: snapshot {sid} of {ident}")

    rst = f"{pvc['name']}-switchover-{stamp}"
    log(f"{new.name}: Restore {ns}/{rst} into PVC {pvc['name']} from repository {old.name}")
    new.kubectl("create", "-f", "-", stdin=json.dumps({
        "apiVersion": "kopiur.home-operations.com/v1alpha1",
        "kind": "Restore",
        "metadata": {"name": rst, "namespace": ns},
        "spec": {
            "repository": {"kind": "ClusterRepository", "name": old.name},
            "source": {"identity": {**ident, "snapshotID": sid}},
            "target": restore_target(new, app, pvc),
            "credentialProjection": {"enabled": True},
            # An exact mirror: the PVC may hold this site's older copy.
            "options": {"enableFileDeletion": True},
            "mover": restore_mover(pvc),
        },
    }))

    def restored():
        o = new.get("restore.kopiur.home-operations.com", rst, ns)
        ph = o.get("status", {}).get("phase")
        if ph == "Failed":
            raise RuntimeError(f"{new.name}: Restore {rst} failed: {json.dumps(o['status'].get('failure', {}))[:300]} {o['status'].get('logTail', '')[-300:]}")
        return o if ph in ("Completed", "Succeeded") else None

    o = wait(f"Restore {rst}", restored, timeout=3600, every=15)
    log(f"{new.name}: restored {json.dumps(o['status'].get('progress', {}))}")
    if pvc.get("transfer_only"):
        log(f"{old.name}: transfer-only PVC: deleting Snapshot {snap} (and its kopia snapshot)")
        old.kubectl("delete", "snapshot.kopiur.home-operations.com", snap, "-n", ns, "--wait=false")


def cmd_switchover(args):
    app = load_app(args.app)
    p = app["prefix"]
    if args.to not in SITES:
        die(f"--to must be one of {SITES}")
    new = Site(args.to)
    old = Site(next(s for s in SITES if s != args.to))
    log(f"{'PROMOTE' if args.promote else 'switchover'} {args.app}: {old.name} -> {new.name}")
    if app.get("lease"):
        check_lease(args.app, old, new, args.promote)
    elif args.promote:
        die(f"{args.app} has no site lease and no standby database: --promote is for warm apps")
    if args.promote:
        return promote(args, app, old, new)
    po, pn = preflight(old, new, app)
    if not args.yes:
        if input(f"{args.app} stops on {old.name} and starts on {new.name}. Type the app name to go on: ").strip() != args.app:
            die("aborted")
    t0 = time.time()
    stamp = time.strftime("%Y%m%d%H%M%S")

    old_ov = {f"{p}_REPLICAS": "0"}
    if app.get("backup_schedule"):
        old_ov[f"{p}_BACKUP_SUSPEND"] = "true"
    # toggles: {VAR: [value where the app is off, value where it runs]}
    old_ov.update({k: v[0] for k, v in app.get("toggles", {}).items()})
    old.set_overrides(args.app, old_ov)
    old.reconcile(app["kustomizations"]["app"])
    reconcile_backup(old, app)
    wait(f"{args.app} stopped on {old.name}", lambda: deployments_stopped(old, app))
    t_stopped = time.time()
    log(f"{old.name}: {args.app} stopped")

    if not args.skip_pvcs:
        try:
            if app.get("prebind"):
                prebind(new, app, args.app)
            for pvc in app["pvcs"]:
                copy_pvc(old, new, app, pvc, stamp)
        except RuntimeError as e:
            # Nothing has moved yet (the database is untouched): put the app
            # back on the old site and stop.
            log(f"ERROR: {e}")
            log(f"rolling back: {args.app} starts again on {old.name}")
            old.set_overrides(args.app, {})
            old.reconcile(app["kustomizations"]["app"])
            reconcile_backup(old, app)
            try:
                wait(f"{args.app} back on {old.name}", lambda: deployments_ready(old, app), timeout=900)
                log(f"{old.name}: {args.app} running again; nothing changed on {new.name} except restored PVCs")
            except RuntimeError as e2:
                log(f"ERROR: {e2}")
            sys.exit(1)
    t_pvcs = time.time()

    new_ov = {f"{p}_REPLICAS": "1"}
    if app.get("backup_schedule"):
        new_ov[f"{p}_BACKUP_SUSPEND"] = "false"
    new_ov.update({k: v[1] for k, v in app.get("toggles", {}).items()})
    if pg_list(app):
        # Demote every cluster on the old site, then promote each on the new
        # one with its own token.
        for cl, pp in pg_list(app):
            old_ov[f"{pp}_PG_PRIMARY"] = new.name
        old.set_overrides(args.app, old_ov)
        old.reconcile(app["kustomizations"]["db"])
        for cl, pp in pg_list(app):
            token = wait(f"{cl} demotion token on {old.name}", lambda cl=cl: (pg_state(old, app, cl) or {}).get("demotion_token"), timeout=600)
            try:
                info = json.loads(base64.b64decode(token))
                log(f"{old.name}: {cl} demoted; token LSN {info.get('latestCheckpointREDOLocation') or info}")
            except Exception:
                log(f"{old.name}: {cl} demoted")
            new_ov.update({f"{pp}_PG_PRIMARY": new.name, f"{pp}_PG_PROMOTION_TOKEN": token})
        new.set_overrides(args.app, new_ov)
        new.reconcile(app["kustomizations"]["db"])
        for cl, pp in pg_list(app):
            wait(f"{cl} primary on {new.name}",
                 lambda cl=cl: (lambda s: s and not s["in_recovery"] and s["phase"] == "Cluster in healthy state")(pg_state(new, app, cl)),
                 timeout=900)
            log(f"{new.name}: {cl} is primary")
    else:
        new.set_overrides(args.app, new_ov)
    t_promoted = time.time()
    new.reconcile(app["kustomizations"]["app"])
    reconcile_backup(new, app)
    wait(f"{args.app} ready on {new.name}", lambda: deployments_ready(new, app), timeout=1200)

    # Ready isn't serving: Mealie has no readiness probe, so its Deployment is
    # Ready seconds before the app listens. Downtime ends when this answers.
    chk = app.get("check")
    if chk:
        def answers():
            cmd = chk.get("command") or ["python3", "-c", f"import urllib.request;print(urllib.request.urlopen({chk['url']!r},timeout=10).status)"]
            p_ = new.kubectl("exec", "-n", app["namespace"], chk.get("workload") or f"deploy/{chk['deployment']}", "-c", chk["container"], "--",
                             *cmd, check=False)
            return p_.stdout.strip() if p_.returncode == 0 else None
        what = chk.get("url") or " ".join(chk.get("command", []))
        status = wait(f"{what} on {new.name}", answers, timeout=600, every=5)
        log(f"{new.name}: check {what}: {status}")
    t_ready = time.time()

    for cl, _ in pg_list(app):
        pn2 = pg_state(old, app, cl) or {}
        log(f"{old.name}: {cl} now in_recovery={pn2.get('in_recovery')} (follows {new.name})")
    print(json.dumps({
        "app": args.app, "from": old.name, "to": new.name,
        "downtime_s": round(t_ready - t_stopped),
        "stop_s": round(t_stopped - t0), "pvc_copy_s": round(t_pvcs - t_stopped),
        "db_switch_s": round(t_promoted - t_pvcs), "app_start_s": round(t_ready - t_promoted),
        "rpo": "0 (promotion token: replayed to the demoted primary's last LSN)" if app.get("postgres") else "0 (stopped before the copy)",
    }, indent=2))
    log("done. To make it permanent: a PR to both cluster-settings, then `site-failover clear`.")


def promote(args, app, old, new):
    p = app["prefix"]
    for cl, _ in pg_list(app):
        pn = pg_state(new, app, cl)
        if not pn or not pn["in_recovery"]:
            die(f"{new.name}: {cl} isn't a replica here ({pn})")
        replayed = new.psql(pn["pod"], "select pg_last_wal_replay_lsn(), now() - pg_last_xact_replay_timestamp()")
        log(f"{new.name}: {cl} replayed to {replayed} (writes after that on {old.name} are lost)")
    if not args.yes and input(f"Promote {args.app} on {new.name} WITHOUT a token ({old.name} must be dead). Type the app name: ").strip() != args.app:
        die("aborted")
    t0 = time.time()
    stamp = time.strftime("%Y%m%d%H%M%S")
    # The PVCs: the old site's newest snapshot, from S3 (the old site isn't needed).
    for pvc in app["pvcs"]:
        rst = f"{pvc['name']}-promote-{stamp}"
        log(f"{new.name}: Restore {rst} from {old.name}'s newest {pvc['policy']} snapshot")
        new.kubectl("create", "-f", "-", stdin=json.dumps({
            "apiVersion": "kopiur.home-operations.com/v1alpha1",
            "kind": "Restore",
            "metadata": {"name": rst, "namespace": app["namespace"]},
            "spec": {
                "repository": {"kind": "ClusterRepository", "name": old.name},
                "source": {"identity": {"hostname": app["namespace"], "username": f"{app['namespace']}-{pvc['policy']}",
                                        "sourcePath": f"/pvc/{pvc['name']}"}},
                "target": {"pvcRef": {"name": pvc["name"]}},
                "credentialProjection": {"enabled": True},
                "options": {"enableFileDeletion": True},
                "mover": restore_mover(pvc),
            },
        }))

        def restored(rst=rst):
            o = new.get("restore.kopiur.home-operations.com", rst, app["namespace"])
            ph = o.get("status", {}).get("phase")
            if ph == "Failed":
                die(f"{new.name}: Restore {rst} failed: {json.dumps(o['status'].get('failure', {}))[:300]}")
            return ph in ("Completed", "Succeeded")
        wait(f"Restore {rst}", restored)
    new_ov = {f"{p}_REPLICAS": "1"}
    new_ov.update({f"{pp}_PG_PRIMARY": new.name for _, pp in pg_list(app)})
    if app.get("backup_schedule"):
        new_ov[f"{p}_BACKUP_SUSPEND"] = "false"
    new_ov.update({k: v[1] for k, v in app.get("toggles", {}).items()})
    new.set_overrides(args.app, new_ov)
    new.reconcile(app["kustomizations"]["db"])
    for cl, _ in pg_list(app):
        wait(f"{cl} primary on {new.name}",
             lambda cl=cl: (lambda s: s and not s["in_recovery"] and s["phase"] == "Cluster in healthy state")(pg_state(new, app, cl)),
             timeout=900)
    new.reconcile(app["kustomizations"]["app"])
    reconcile_backup(new, app)
    wait(f"{args.app} ready on {new.name}", lambda: deployments_ready(new, app), timeout=1200)
    log(f"{new.name}: {args.app} promoted and running after {round(time.time() - t0)} s. {old.name} stays fenced: "
        f"rebuild its {', '.join(cl for cl, _ in pg_list(app))} as replicas, then set the lease back to \"none\" (docs/wsl/multi-site.md).")


def cmd_clear(args):
    app = load_app(args.app)
    for s in map(Site, SITES):
        ov = {k: v for k, v in s.overrides().items() if k.startswith(app["prefix"] + "_")}
        if not ov:
            continue
        log(f"{s.name}: clearing {sorted(ov)}; the app returns to git's values there")
        if not args.yes and input("Type the app name to go on: ").strip() != args.app:
            die("aborted")
        # git's cluster-settings first: the PR that made the move permanent may
        # not be applied on this site yet, and without it the app would fall
        # back to the defaults (2026-11-05: Immich started on the old site).
        log(f"{s.name}: applying git's cluster-settings before clearing")
        s.run(["flux", "reconcile", "source", "git", "flux-system", "-n", "flux-system"], check=False, timeout=600)
        s.reconcile(TOP_KS[s.name], timeout="10m")
        s.set_overrides(args.app, {})
        if app.get("postgres"):
            s.reconcile(app["kustomizations"]["db"])
        s.reconcile(app["kustomizations"]["app"])
        reconcile_backup(s, app)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("status")
    s.add_argument("app")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("switchover")
    s.add_argument("app")
    s.add_argument("--to", required=True)
    s.add_argument("--yes", action="store_true")
    s.add_argument("--skip-pvcs", action="store_true", help="don't copy PVCs (the new site's copy is current)")
    s.add_argument("--promote", action="store_true", help="unplanned: the old site is dead and fenced by its site lease")
    s.set_defaults(fn=cmd_switchover)
    s = sub.add_parser("clear")
    s.add_argument("app")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_clear)
    a = ap.parse_args()
    try:
        a.fn(a)
    except RuntimeError as e:
        die(str(e))


if __name__ == "__main__":
    main()
