#!/usr/bin/env bash
# Checks the rendered ClusterRole of Trivy Operator on each cluster that lists
# the app (kubernetes/apps/security/trivy-operator/README.md, "Its roles").
#
#   bin/trivy-operator-roles kubernetes/clusters/wsl-02 [more cluster paths]
#
# flate renders the HelmRelease with its post-render patch. Outside the report
# CRDs of the operator (aquasecurity.github.io), each rule of the ClusterRole
# `trivy-operator` may only get, list or watch, and no rule names pods/log.
# The test ops of the patch guard the order of the chart's rules; this check
# guards the result, so a chart release that adds a rule with a write, or a
# log read, fails here. Needs flate (FLATE_SUPPLY set, as in kubernetes.yaml)
# and yq.
set -euo pipefail

app="../../../apps/security/trivy-operator/ks.yaml"
status=0
for cluster in "$@"; do
  if ! grep -qF -- "- ${app}" "${cluster}/apps/kustomization.yaml"; then
    echo "${cluster}: does not list trivy-operator, nothing to check"
    continue
  fi
  rendered="$(flate build all --no-progress -p "${cluster}" --only-kinds ClusterRole 2>/dev/null)"
  role="$(yq 'select(.kind == "ClusterRole" and .metadata.name == "trivy-operator")' <<<"${rendered}")"
  if [[ -z "${role}" ]]; then
    echo "::error::${cluster}: no ClusterRole trivy-operator in the render"
    status=1
    continue
  fi
  wide="$(yq -o=json -I=0 '.rules[]
    | select((.resources[] | select(. == "pods/log"))
        or ((.apiGroups | all_c(. == "aquasecurity.github.io")) | not)
           and ([.verbs[] | select(. != "get" and . != "list" and . != "watch")] | length > 0))' <<<"${role}")"
  if [[ -n "${wide}" ]]; then
    echo "::error::${cluster}: the ClusterRole trivy-operator is wider than its README says:"
    echo "${wide}"
    status=1
  else
    echo "${cluster}: the ClusterRole trivy-operator writes only the reports, and reads no pod log"
  fi
done
exit "${status}"
