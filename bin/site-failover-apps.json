{
  "_comment": "Apps bin/site-failover can move between homelab-wsl and homelab-wsl-02. prefix: the app's variable prefix in cluster-settings / site-overrides (<prefix>_REPLICAS, _PG_PRIMARY, _PG_PROMOTION_TOKEN, _BACKUP_SUSPEND). pvcs: copied with kopiur (policy on both sites); transfer_only: the snapshot is deleted after the restore (for a PVC that isn't backed up). docs/wsl/multi-site.md. lease: the app has a site lease (fencing). workloads: deployment/x or statefulset/x (default: deployments). postgres optional. A pvc with create {capacity, storageClass} is created by the restore when missing (a StatefulSet's).",
  "mealie": {
    "prefix": "MEALIE",
    "namespace": "production",
    "kustomizations": {
      "db": "mealie-db",
      "app": "mealie",
      "backup": "kopiur-policies"
    },
    "postgres": "mealie-pg",
    "deployments": [
      "mealie"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "mealie-config",
        "policy": "mealie",
        "uid": 1000,
        "gid": 1000
      }
    ],
    "check": {
      "deployment": "mealie",
      "container": "app",
      "url": "http://localhost:9000/api/app/about"
    },
    "lease": true
  },
  "transcriber": {
    "prefix": "TRANSCRIBER",
    "namespace": "production",
    "kustomizations": {
      "db": "transcriber-db",
      "app": "transcriber",
      "backup": "kopiur-policies"
    },
    "postgres": "transcriber-pg",
    "deployments": [
      "transcriber",
      "transcriber-frontend"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "transcriber-audio",
        "policy": "transcriber",
        "uid": 1000,
        "gid": 1000
      }
    ],
    "check": {
      "deployment": "transcriber",
      "container": "web",
      "url": "http://localhost:8081/api/healthz"
    },
    "lease": true
  },
  "changedetection": {
    "prefix": "CHANGEDETECTION",
    "namespace": "production",
    "kustomizations": {
      "app": "changedetection",
      "backup": "kopiur-policies"
    },
    "workloads": [
      "statefulset/changedetection"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "config-changedetection-0",
        "policy": "changedetection",
        "uid": 1000,
        "gid": 1000,
        "create": {
          "capacity": "1Gi",
          "storageClass": "local-path"
        }
      }
    ],
    "check": {
      "workload": "statefulset/changedetection",
      "container": "app",
      "url": "http://localhost:5000/"
    }
  }
}
