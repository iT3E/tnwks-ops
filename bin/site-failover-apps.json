{
  "_comment": "Apps bin/site-failover can move between homelab-wsl and homelab-wsl-02. prefix: the app's variable prefix in cluster-settings / site-overrides (<prefix>_REPLICAS, _PG_PRIMARY, _PG_PROMOTION_TOKEN, _BACKUP_SUSPEND). pvcs: copied with kopiur (policy on both sites); transfer_only: the snapshot is deleted after the restore (for a PVC that isn't backed up). docs/wsl/multi-site.md. lease: the app has a site lease (fencing). workloads: deployment/x or statefulset/x (default: deployments). postgres optional. A pvc with create {capacity, storageClass} is created by the restore when missing (a StatefulSet's). prebind: start the app once on the new site before copying, so local-path binds all its PVCs (incl. prebind_extra, shared ones not copied) on one node. restore_uid: the restore mover's user when it differs from the snapshot's. restore_privileged: kopiur privilegedMode for the restore (root with file capabilities; the namespace must allow privileged movers).",
  "mealie": {
    "prefix": "MEALIE",
    "namespace": "production",
    "kustomizations": {
      "db": "mealie-db",
      "app": "mealie",
      "backup": "kopiur-policies"
    },
    "postgres": "mealie-pg",
    "deployments": [
      "mealie"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "mealie-config",
        "policy": "mealie",
        "uid": 1000,
        "gid": 1000
      }
    ],
    "check": {
      "deployment": "mealie",
      "container": "app",
      "url": "http://localhost:9000/api/app/about"
    },
    "lease": true
  },
  "transcriber": {
    "prefix": "TRANSCRIBER",
    "namespace": "production",
    "kustomizations": {
      "db": "transcriber-db",
      "app": "transcriber",
      "backup": "kopiur-policies"
    },
    "postgres": "transcriber-pg",
    "deployments": [
      "transcriber",
      "transcriber-frontend"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "transcriber-audio",
        "policy": "transcriber",
        "uid": 1000,
        "gid": 1000
      }
    ],
    "check": {
      "deployment": "transcriber",
      "container": "web",
      "url": "http://localhost:8081/api/healthz"
    },
    "lease": true
  },
  "changedetection": {
    "prefix": "CHANGEDETECTION",
    "namespace": "production",
    "kustomizations": {
      "app": "changedetection",
      "backup": "kopiur-policies"
    },
    "workloads": [
      "statefulset/changedetection"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "config-changedetection-0",
        "policy": "changedetection",
        "uid": 1000,
        "gid": 1000,
        "create": {
          "capacity": "1Gi",
          "storageClass": "local-path"
        }
      }
    ],
    "check": {
      "workload": "statefulset/changedetection",
      "container": "app",
      "url": "http://localhost:5000/"
    }
  },
  "immich": {
    "prefix": "IMMICH",
    "namespace": "selfhosted",
    "kustomizations": {
      "app": [
        "immich",
        "immich-sync",
        "immichframe",
        "kitchen-screensaver"
      ]
    },
    "workloads": [
      "deployment/immich-server",
      "deployment/immich-machine-learning",
      "deployment/immich-valkey",
      "statefulset/immich-postgres",
      "deployment/immichframe",
      "deployment/kitchen-screensaver"
    ],
    "toggles": {
      "IMMICH_SYNC_SUSPEND": [
        "true",
        "false"
      ]
    },
    "pvcs": [
      {
        "name": "immich-library",
        "policy": "immich-library",
        "uid": 1000,
        "gid": 1000,
        "transfer_only": true
      },
      {
        "name": "data-immich-postgres-0",
        "policy": "immich-postgres",
        "uid": 999,
        "gid": 999,
        "transfer_only": true,
        "create": {
          "capacity": "10Gi",
          "storageClass": {
            "homelab-wsl": "local-path-ext4",
            "homelab-wsl-02": "local-path"
          }
        }
      }
    ],
    "check": {
      "workload": "deploy/immich-server",
      "container": "app",
      "command": [
        "curl",
        "-fsS",
        "http://localhost:2283/api/server/ping"
      ]
    }
  },
  "firefly": {
    "prefix": "FIREFLY",
    "namespace": "production",
    "kustomizations": {
      "db": [
        "firefly-db",
        "finance-sync-db"
      ],
      "app": [
        "firefly",
        "finance-sync"
      ],
      "backup": "kopiur-policies"
    },
    "postgres": [
      {
        "cluster": "firefly-pg",
        "prefix": "FIREFLY"
      },
      {
        "cluster": "finance-sync-pg",
        "prefix": "FINANCE_SYNC"
      }
    ],
    "lease": true,
    "workloads": [
      "deployment/firefly"
    ],
    "backup_schedule": true,
    "toggles": {
      "FIREFLY_CRON_SUSPEND": [
        "true",
        "false"
      ],
      "FINANCE_SYNC_SUSPEND": [
        "true",
        "false"
      ],
      "FINANCE_SYNC_BACKUP_SUSPEND": [
        "true",
        "false"
      ]
    },
    "pvcs": [
      {
        "name": "firefly-upload",
        "policy": "firefly",
        "uid": 33,
        "gid": 33
      },
      {
        "name": "finance-sync-state",
        "policy": "finance-sync",
        "uid": 1000,
        "gid": 1000
      }
    ],
    "check": {
      "workload": "deploy/firefly",
      "container": "app",
      "command": [
        "curl",
        "-fsS",
        "-o",
        "/dev/null",
        "-w",
        "%{http_code}",
        "http://localhost:8080/health"
      ]
    }
  },
  "media": {
    "prefix": "MEDIA",
    "namespace": "media",
    "kustomizations": {
      "app": [
        "sonarr",
        "radarr",
        "prowlarr",
        "qbittorrent",
        "recyclarr"
      ]
    },
    "workloads": [
      "deployment/sonarr",
      "deployment/radarr",
      "deployment/prowlarr",
      "statefulset/qbittorrent",
      "statefulset/recyclarr"
    ],
    "pvcs": [
      {
        "name": "sonarr-config",
        "policy": "media-sonarr",
        "uid": 1000,
        "gid": 1000,
        "transfer_only": true,
        "restore_privileged": true
      },
      {
        "name": "radarr-config",
        "policy": "media-radarr",
        "uid": 1000,
        "gid": 1000,
        "transfer_only": true,
        "restore_privileged": true
      },
      {
        "name": "prowlarr-config",
        "policy": "media-prowlarr",
        "uid": 1000,
        "gid": 1000,
        "transfer_only": true,
        "restore_privileged": true
      },
      {
        "name": "data-qbittorrent-0",
        "policy": "media-qbittorrent",
        "uid": 568,
        "gid": 568,
        "transfer_only": true,
        "restore_privileged": true
      },
      {
        "name": "config-recyclarr-0",
        "policy": "media-recyclarr",
        "uid": 1000,
        "gid": 1000,
        "transfer_only": true,
        "restore_privileged": true
      }
    ],
    "check": {
      "workload": "deploy/sonarr",
      "container": "app",
      "command": [
        "sh",
        "-c",
        "wget -qO- http://localhost:8989/ping || curl -fsS http://localhost:8989/ping"
      ]
    },
    "prebind": true,
    "prebind_extra": [
      "cephfs-hdd-subvolume-qbit"
    ]
  },
  "home-assistant": {
    "prefix": "HOME_ASSISTANT",
    "namespace": "home-automation",
    "kustomizations": {
      "db": "home-assistant-db",
      "app": "home-assistant",
      "backup": "kopiur-policies"
    },
    "postgres": "home-assistant-pg",
    "lease": true,
    "workloads": [
      "statefulset/home-assistant"
    ],
    "backup_schedule": true,
    "pvcs": [
      {
        "name": "config-home-assistant-0",
        "policy": "home-assistant",
        "uid": 568,
        "gid": 568,
        "create": {
          "capacity": "5Gi",
          "storageClass": "local-path"
        }
      }
    ],
    "check": {
      "workload": "statefulset/home-assistant",
      "container": "app",
      "url": "http://localhost:8123/manifest.json"
    }
  },
  "unifi": {
    "prefix": "UNIFI",
    "namespace": "networking",
    "kustomizations": {
      "app": [
        "unifi",
        "unpoller"
      ],
      "backup": "kopiur-policies"
    },
    "workloads": [
      "statefulset/unifi"
    ],
    "backup_schedule": true,
