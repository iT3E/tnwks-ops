      {
        "name": "mongo-unifi-0",
        "policy": "unifi-mongo",
        "uid": 999,
        "gid": 999,
        "transfer_only": true,
        "restore_privileged": true
      }
    ],
    "check": {
      "workload": "statefulset/unifi",
      "container": "app",
      "command": [
