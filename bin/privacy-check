#!/usr/bin/env bash
# Fail if any denylisted term (family names, personal emails) appears in the
# repo, a commit or a GitHub text. The repo is public; see "Privacy" in
# AGENTS.md.
#
#   bin/privacy-check                 # tracked files (working tree) + paths
#   bin/privacy-check --cached        # the index + your git identity (pre-commit)
#   bin/privacy-check --commits A..B  # also those commits' messages and identities
#   bin/privacy-check --message FILE  # a commit message only (commit-msg hook)
#   bin/privacy-check --text          # stdin only (a PR body or comment you're about to post)
#
# Terms come from $PRIVACY_TERMS (CI: the PRIVACY_TERMS Actions secret) or
# else from .github/privacy-terms.sops.yaml (`terms`, one per line). Edit the
# list with `sops .github/privacy-terms.sops.yaml`, then `task privacy:sync`.
#
# Matching is case-insensitive. A term with "@" or "." matches anywhere. Any
# other term matches as a word: no letter directly before it, and no letter
# after it except a plural/possessive "s" (so "driver" passes, "chore_x_1"
# and "xs-api" are hits). Text in $PRIVACY_EXTRA_TEXT (CI: the PR title and
# body) is checked too.
#
# Exceptions (files only): .github/privacy-allow lists git pathspec globs to
# skip, and a line that contains "privacy:allow" is skipped. Messages, PR
# text and comments have no exceptions.
#
# Hits print as "term #N: <where>". The matched text is never printed, since
# CI logs on a public repo are public.
set -euo pipefail

cached=""
range=""
message=""
text_mode=""
while (($#)); do
  case "$1" in
    --cached) cached="--cached" ;;
    --commits) range="${2:?--commits needs a range}"; shift ;;
    --message) message="${2:?--message needs a file}"; shift ;;
    --text) text_mode=1 ;;
    *) echo "usage: privacy-check [--cached] [--commits A..B] [--message FILE] [--text]" >&2; exit 2 ;;
  esac
  shift
done

# Read the text inputs before changing directory (relative paths, stdin).
input=""
if [[ -n "${message}" ]]; then
  # What git keeps: drop comment lines and everything below the scissors line.
  input="$(sed -e '/^# -\{8,\} >8 -\{8,\}$/,$d' -e '/^#/d' "${message}")"
elif [[ -n "${text_mode}" ]]; then
  input="$(cat)"
fi

cd "$(git rev-parse --show-toplevel)"
terms_file=".github/privacy-terms.sops.yaml"
allow_file=".github/privacy-allow"

pathspec=(. ":(exclude)${terms_file}")
if [[ -f "${allow_file}" ]]; then
  while IFS= read -r g; do
    [[ -z "${g}" || "${g}" == \#* ]] || pathspec+=(":(exclude,glob)${g}")
  done <"${allow_file}"
fi

if [[ -n "${PRIVACY_TERMS:-}" ]]; then
  raw="${PRIVACY_TERMS}"
else
  raw="$(sops -d --extract '["terms"]' "${terms_file}")"
fi
mapfile -t terms < <(tr -d '\r' <<<"${raw}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v -e '^$' -e '^#' || true)
((${#terms[@]})) || { echo "privacy-check: no terms loaded" >&2; exit 2; }

pattern() {
  local t q
  t="$1"
  q="$(sed -e 's/[][\\.^$*+?(){}|\/]/\\&/g' <<<"${t}")"
  if [[ "${t}" == *[@.]* ]]; then
    printf '(?i)%s' "${q}"
  else
    printf '(?i)(?<![a-z])%s(?:s)?(?![a-z])' "${q}"
  fi
}

hits=0
report() { echo "term #$1: $2"; hits=$((hits + 1)); }
has() { grep -q -P -e "$1" <<<"$2"; }

for i in "${!terms[@]}"; do
  n=$((i + 1))
  p="$(pattern "${terms[$i]}")"

  if [[ -n "${message}" ]]; then
    if has "${p}" "${input}"; then report "${n}" "commit message"; fi
    continue
  fi
  if [[ -n "${text_mode}" ]]; then
    if has "${p}" "${input}"; then report "${n}" "text"; fi
    continue
  fi

  # File contents, as path:line.
  while IFS= read -r loc; do
    report "${n}" "${loc}"
  done < <(git grep ${cached} -I -n -P -e "${p}" -- "${pathspec[@]}" | grep -v -F 'privacy:allow' | cut -d: -f1,2 || true)

  # File and directory names.
  while IFS= read -r f; do
    report "${n}" "path ${f}"
  done < <(git ls-files -- "${pathspec[@]}" | grep -P -e "${p}" || true)

  # The identity the next commit gets.
  if [[ -n "${cached}" ]]; then
    for v in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
      if has "${p}" "$(git var "${v}" 2>/dev/null || true)"; then
        report "${n}" "${v} (git config user.name/user.email)"
      fi
    done
  fi

  if [[ -n "${range}" ]]; then
    while IFS= read -r sha; do
      report "${n}" "commit ${sha:0:12} (message or author/committer)"
    done < <(git log --format='%H%x09%an <%ae>%x09%cn <%ce>%x09%B%x00' "${range}" |
      perl -0 -ne 'BEGIN { $re = shift @ARGV } print substr($_, 0, 40), "\n" if /$re/' "${p}" || true)
  fi

  if [[ -n "${PRIVACY_EXTRA_TEXT:-}" ]] && has "${p}" "${PRIVACY_EXTRA_TEXT}"; then
    report "${n}" "PR title or body"
  fi
done

if ((hits)); then
  echo "privacy-check: ${hits} hit(s). Remove the term or move it to a SOPS secret." >&2
  exit 1
fi
echo "privacy-check: clean (${#terms[@]} terms)"
