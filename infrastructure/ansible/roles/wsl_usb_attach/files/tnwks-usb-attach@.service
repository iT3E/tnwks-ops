[Unit]
Description=tnwks USB attach (%i): keep dongle %i attached into WSL with the usbip client
# The Windows host only needs to start WSL; this unit attaches the dongle on
# every WSL boot and again after a detach or replug, so a WSL-only restart
# recovers without a Windows event.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# %i is the URL-decoded instance name, a VID:PID (e.g. 0658:0200). systemd
# escapes the ':' as the instance arg; the script takes it verbatim.
ExecStart=/usr/local/bin/tnwks-usb-attach %i
# The script loops and tries again each round; if it exits (the usbip client
# of usbipd-win is not reachable yet), systemd starts it again.
Restart=always
RestartSec=5
# modprobe and usbip attach need root.
User=root

[Install]
WantedBy=multi-user.target
