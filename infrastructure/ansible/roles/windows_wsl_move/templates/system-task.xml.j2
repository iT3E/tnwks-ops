<?xml version="1.0" encoding="UTF-16"?>
<!-- Managed by tnwks-ops (role windows_wsl_move). SYSTEM. The window
     procedure has no trigger: the lead starts it. The boot task of the way
     back runs at each boot, and acts only after a started window
     (Invoke-TnwksMoveWindow.ps1, mode boot). -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>The move of the distro, {{ 'the boot task of the way back' if item == 'boot' else 'the window procedure' }} (Design Doc 0004, section 9).</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
{% if item == 'boot' %}
  <Triggers>
    <BootTrigger />
  </Triggers>
{% else %}
  <Triggers />
{% endif %}
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "{{ wsl_move_dir | e }}\Invoke-TnwksMoveWindow.ps1" -Config "{{ wsl_move_dir | e }}\window.json"{% if item == 'boot' %} -Mode boot{% else %} -Request "{{ wsl_move_request_file | e }}"{% endif %}</Arguments>
    </Exec>
  </Actions>
</Task>
