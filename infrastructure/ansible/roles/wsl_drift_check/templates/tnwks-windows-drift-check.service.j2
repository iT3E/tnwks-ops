[Unit]
Description=Nightly Ansible --check of the Windows host, reported to Prometheus (docs/wsl/windows-ansible.md)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ wsl_distro_user }}
Environment=HOME={{ wsl_distro_home }}
# task, yq and sops come from Homebrew, uvx from ~/.local/bin.
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:{{ wsl_distro_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/tnwks-windows-drift-check
TimeoutStartSec=30min
Nice=10
