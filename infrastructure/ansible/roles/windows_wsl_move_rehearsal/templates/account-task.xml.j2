<?xml version="1.0" encoding="UTF-16"?>
<!-- Managed by tnwks-ops (role windows_wsl_move_rehearsal). An account of the
     rehearsal of the move, by S4U, with no elevation. No trigger: the play or
     the window procedure starts it. -->
{% set acct = wsl_move_rehearsal_accounts[task.key] %}
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>The rehearsal of the move, account {{ task.key | upper }}, step {{ task.step }} (Design Doc 0004, section 9). Removed with the rehearsal.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>{{ acct.name | e }}</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
{% if task.step == 'start' %}
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
{% else %}
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
{% endif %}
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
{% if task.step == 'start' and task.key == 'b' %}
    <!-- Registered disabled, as step 3 registers the start tasks of the new
         account. The window enables it, and no apply changes its state. -->
    <Enabled>false</Enabled>
{% endif %}
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers />
  <Actions Context="Author">
    <Exec>
{% if task.step == 'start' %}
      <!-- One wsl.exe client that holds the distro and its VM, as the keepalive does. -->
      <Command>C:\Windows\System32\wsl.exe</Command>
      <Arguments>-d {{ wsl_move_rehearsal_distro | e }} -u root -e /bin/sleep infinity</Arguments>
{% else %}
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "{{ wsl_move_rehearsal_dir | e }}\Invoke-TnwksWslAccountTask.ps1" -Config "{{ wsl_move_rehearsal_dir | e }}\config-{{ task.key }}.json" -Step {{ 'import' if task.step == 'import-elsewhere' else task.step }}{% if task.step == 'import-elsewhere' %} -Folder "{{ wsl_move_rehearsal_elsewhere | e }}"{% endif %}</Arguments>
{% endif %}
    </Exec>
  </Actions>
</Task>
