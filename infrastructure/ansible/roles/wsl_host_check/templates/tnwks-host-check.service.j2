[Unit]
Description=The host check of the security platform: the updates of this distro, for windows_exporter
After=local-fs.target

[Service]
Type=oneshot
User={{ wsl_distro_user }}
# The first time each pending upgrade was seen.
StateDirectory={{ wsl_host_check_name }}
StateDirectoryMode=0700
# The answer of the write test as root, for the check of this run.
RuntimeDirectory={{ wsl_host_check_name }}
RuntimeDirectoryMode=0755
# The check reads, and writes only its state and its .prom file. The write
# test makes a file in the textfile directory only if the try may, and then
# removes it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
TimeoutStartSec=15min
# The write test as root (Design Doc 0004, section 5.9): "+" runs this step
# with full privileges, as root, so the mode that /mnt/c shows does not stop
# the try before Windows answers. "-": its exit code (the answer) does not
# stop the check, which reads the answer from the file.
ExecStartPre=-+/usr/local/bin/{{ wsl_host_check_name }} \
  --system "{{ inventory_hostname }}" \
  --textfile-dir "{{ wsl_host_check_textfile_dir }}" \
  --write-test-dir "{{ wsl_host_check_write_test_dir }}" \
  --write-test-only \
  --write-test-result "/run/{{ wsl_host_check_name }}/write-test.json"
ExecStart=/usr/local/bin/{{ wsl_host_check_name }} \
  --system "{{ inventory_hostname }}" \
  --textfile-dir "{{ wsl_host_check_textfile_dir }}" \
  --write-test-dir "{{ wsl_host_check_write_test_dir }}" \
  --write-test-result "/run/{{ wsl_host_check_name }}/write-test.json" \
  --file-name "{{ wsl_host_check_file }}" \
  --state-file "/var/lib/{{ wsl_host_check_name }}/state.json" \
  --updates-max-age-days {{ wsl_host_check_updates_max_age_days }} \
  --lists-max-age-hours {{ wsl_host_check_lists_max_age_hours }}
