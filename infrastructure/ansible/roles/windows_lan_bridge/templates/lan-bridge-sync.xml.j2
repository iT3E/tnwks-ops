<?xml version="1.0" encoding="UTF-16"?>
<!-- Managed by tnwks-ops (role windows_lan_bridge). -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Principals>
    <Principal id="Author">
{% if wsl_start_unelevated | bool %}
      <!-- SYSTEM: the rules need admin rights, and SYSTEM's wsl.exe can not
           see the distro of the user, so this task starts no process in it. -->
      <UserId>S-1-5-18</UserId>
{% else %}
      <UserId>{{ lan_bridge_user | e }}</UserId>
      <LogonType>S4U</LogonType>
{% endif %}
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
{% if wsl_start_unelevated | bool %}
    <!-- The address file changes after the task tnwks-lan-bridge-ip runs: at
         logon, 15 seconds after a vNIC reset, and each 5 minutes. -->
    <TimeTrigger>
      <StartBoundary>2026-11-16T00:02:00</StartBoundary>
      <Repetition><Interval>PT5M</Interval></Repetition>
    </TimeTrigger>
{% endif %}
    <LogonTrigger />
    <!-- VmSwitch 232 (VM NIC connected) lands in the System log, never in
         VmSwitch-Operational. The 15s delay lets WSL answer hostname -I. -->
    <EventTrigger>
      <Delay>{{ 'PT45S' if wsl_start_unelevated | bool else 'PT15S' }}</Delay>
      <Subscription>&lt;QueryList&gt;
  &lt;Query Id="0" Path="System"&gt;
    &lt;Select Path="System"&gt;
      *[System[Provider[@Name='Microsoft-Windows-Hyper-V-VmSwitch'] and (EventID=232)]]
    &lt;/Select&gt;
  &lt;/Query&gt;
&lt;/QueryList&gt;</Subscription>
    </EventTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "&amp; '{{ lan_bridge_dir }}\Sync-TnwksLanBridge.ps1'{% if wsl_start_unelevated | bool %} -IpFile '{{ lan_bridge_ip_file }}'{% endif %} *&gt;&gt; '{{ lan_bridge_dir }}\sync.log'; exit $LASTEXITCODE"</Arguments>
    </Exec>
  </Actions>
</Task>
