<ossec_config>
  <agent>
    <manager>
      <endpoint>MANAGER_IP</endpoint>
    </manager>
    <enrollment>
      <agent_name>{{ wazuh_agent_name }}</agent_name>
      <groups>{{ windows_wazuh_agent_group }}</groups>
    </enrollment>
    <ssl>
      <verification_mode>full</verification_mode>
    </ssl>
  </agent>
  <active-response>
    <disabled>yes</disabled>
  </active-response>
</ossec_config>
