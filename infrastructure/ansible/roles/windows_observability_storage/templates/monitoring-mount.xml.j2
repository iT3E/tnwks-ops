<?xml version="1.0" encoding="UTF-16"?>
<!-- Managed by tnwks-ops (role windows_observability_storage). -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Attach only the recorded C monitoring VHDX and mount its expected ext4 UUID. Normal startup never creates or formats a disk.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>{{ windows_desktop_user | e }}</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <BootTrigger />
    <TimeTrigger>
      <StartBoundary>2026-11-01T00:00:00</StartBoundary>
      <Repetition><Interval>PT1M</Interval></Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{{ observability_storage_dir | e }}\Mount-TnwksObservability.ps1" -Vhdx "{{ observability_storage_vhdx | e }}" -StateDir "{{ observability_storage_dir | e }}" -Distro "{{ observability_storage_distro | e }}"</Arguments>
    </Exec>
  </Actions>
</Task>
