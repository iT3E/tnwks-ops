<?xml version="1.0" encoding="UTF-16"?>
<!-- Managed by tnwks-ops (role windows_wsl_rehearsal). The temporary account,
     by S4U, with no elevation. No trigger: the play starts it. -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>The rehearsal of the account change, step {{ item }} (Design Doc 0004, section 9). Removed with the rehearsal.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>{{ wsl_rehearsal_account | e }}</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
{% if item == 'start' %}
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
{% else %}
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
{% endif %}
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers />
  <Actions Context="Author">
    <Exec>
{% if item == 'start' %}
      <!-- One wsl.exe client that holds the distro and its VM, as the keepalive does. -->
      <Command>C:\Windows\System32\wsl.exe</Command>
      <Arguments>-d {{ wsl_rehearsal_distro | e }} -u root -e /bin/sleep infinity</Arguments>
{% else %}
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "{{ wsl_rehearsal_dir | e }}\Invoke-TnwksRehearsal.ps1" -Step {{ item }} -LogDir "{{ wsl_rehearsal_log_dir | e }}" -Distro "{{ wsl_rehearsal_distro | e }}"{% if item == 'import' %} -RootFs "{{ wsl_rehearsal_dir | e }}\{{ wsl_rehearsal_rootfs.url | basename | e }}" -Sha256 {{ wsl_rehearsal_rootfs.sha256 | upper }}{% elif item == 'write' %} -WriteTestDir "{{ wsl_rehearsal_write_test_dir | e }}"{% elif item == 'mount' %} -Disk "{{ wsl_rehearsal_disk | e }}"{% endif %}</Arguments>
{% endif %}
    </Exec>
  </Actions>
</Task>
