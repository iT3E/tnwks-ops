## ---------------------------------------------------------------------------------------------------------------------
## SECRETS - EXAMPLE / TEMPLATE
##
## Copy to secrets.sops.yaml and encrypt:
##   cp secrets.sops.yaml.example secrets.sops.yaml
##   # fill in real values
##   sops -e -i secrets.sops.yaml
##
## The repo .sops.yaml already has a creation rule for
## `infrastructure/terraform/.*\.sops\.ya?ml`, so encryption picks up the right
## age recipients + AWS KMS key automatically.
##
## NEVER commit the plaintext version. Only secrets.sops.yaml (encrypted) and
## this .example file belong in git.
## ---------------------------------------------------------------------------------------------------------------------

# RouterOS REST API endpoint and the Terraform service account created in
# infrastructure/mikrotik/bootstrap/routeros-bootstrap.rsc section 1.
routeros_url: https://10.98.0.1
routeros_username: terraform
routeros_password: CHANGEME

# Interactive admin account. VyOS interpolated this from ${SSH_VYOS_USERNAME}, so
# it stays a secret here rather than being generated into locals.tf. The matching
# SSH public keys ARE generated, since they are public by definition.
admin_username: CHANGEME

# WireGuard private keys, one per listener in local.wireguard_interfaces.
# main.tf injects these as `wireguard_<name>_private_key`.
#
# These are the SAME keys VyOS used (they were in the VyOS SOPS store as
# SECRET_WIREGUARD_PRIVATE_KEY). Reusing them means existing peers keep working
# without redistributing client configs. If you rotate instead, every peer needs
# a new config.
wireguard_wg01_private_key: CHANGEME
wireguard_wg02_private_key: CHANGEME
