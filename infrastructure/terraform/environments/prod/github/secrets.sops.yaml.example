## Copy to secrets.sops.yaml and encrypt, from the repo root (bin/sops needs
## the .sops.yaml rules):
##   cp secrets.sops.yaml.example secrets.sops.yaml
##   # fill in real values
##   bin/sops -e -i infrastructure/terraform/environments/prod/github/secrets.sops.yaml
##
## NEVER commit the plaintext version. The repository names held in SOPS are
## in repositories.sops.yaml, not here.
## ---------------------------------------------------------------------------------------------------------------------

# Personal access token of the iT3E account, used only by this root
# (docs/operations/github.md, The token). Either:
#   - classic: scope repo only. Not workflow, never delete_repo.
#   - fine-grained: all repositories; Administration read and write,
#     Variables read and write, Actions read, Metadata read. Not Environments.
# Unconfirmed: the classic scope for repository, ruleset, topic and
# Dependabot alert updates (repo expected), and whether the provider needs
# more at startup.
github_token: CHANGEME
