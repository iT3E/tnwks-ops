## ---------------------------------------------------------------------------------------------------------------------
## SECRETS - EXAMPLE / TEMPLATE
##
## The real file is secrets.sops.yaml (encrypted). Edit it in place with
##   sops secrets.sops.yaml
## The repo .sops.yaml rule for `infrastructure/terraform/.*\.sops\.ya?ml` picks
## the recipients. Never commit a plaintext copy.
## ---------------------------------------------------------------------------------------------------------------------

# Controller API, through the WSL cluster's internal ingress.
unifi_url: https://unifi.internal.tnwks.us
# Local admin Terraform logs in as. Created by hand in the controller UI during
# bootstrap (docs/network/unifi.md, "Bootstrap the controller").
unifi_username: terraform
unifi_password: CHANGEME

# The interactive owner account created in the first-run wizard. Not used by
# Terraform; kept here so the controller login can't be lost again.
admin_username: CHANGEME
admin_password: CHANGEME

# Device SSH credentials the controller pushes to every adopted AP
# (unifi_setting.site.mgmt.ssh). With these an orphaned AP can be re-pointed
# with `set-inform` instead of a factory reset.
device_ssh_username: CHANGEME
device_ssh_password: CHANGEME

# The one WLAN. The SSID stays out of the public repo; so do the AP MACs
# below, since UniFi BSSIDs are derived from them.
wlan_ssid: CHANGEME
# Must be the CURRENT Wi-Fi password, or every client drops on first apply.
# unifi_wlan.main refuses to apply while this is CHANGEME.
wlan_passphrase: CHANGEME

# Wired MAC (eth0) of each AP, lowercase colon form.
ap_kitchen_mac: "aa:bb:cc:dd:ee:01"
ap_living_room_mac: "aa:bb:cc:dd:ee:02"
ap_master_mac: "aa:bb:cc:dd:ee:03"
