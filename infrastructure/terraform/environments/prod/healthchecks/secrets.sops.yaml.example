## SECRETS - EXAMPLE / TEMPLATE
##
## Copy to secrets.sops.yaml and encrypt:
##   cp secrets.sops.yaml.example secrets.sops.yaml
##   # fill in real values
##   sops -e -i secrets.sops.yaml
##
## NEVER commit the plaintext version.
## ---------------------------------------------------------------------------------------------------------------------

# healthchecks.io > project > Settings > API Access > read-write API key.
# Only Terraform uses it. The pingers use the project's ping key instead
# (same page), stored with each pinger:
#   - kubernetes/apps/monitoring/alertmanager/app/secrets.sops.yaml
#     healthchecks_watchdog_url = https://hc-ping.com/<ping key>/homelab-wsl
#   - infrastructure/terraform/environments/prod/mikrotik/secrets.sops.yaml
#     healthchecks_ping_key
api_key: CHANGEME
