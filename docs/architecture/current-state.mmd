    isp --> erl_wan
    erl_wan --- erl_risk
    erl_wan --> erl_lan
    erl_lan -->|"VLAN 10 transit"| vy_transit
    vy_transit --- vy_fw
    vy_transit --> vy_stick
    vy_stick --- vy_ctr
    vy_stick -->|"802.1q trunk"| sw
    sw --> v910 & v900 & v610 & v120 & v550 & v140 & voff
    v140 --> eprt

    erl_lan -.->|"both routers<br/>route at dead hops"| dead252
    erl_lan -.-> dead254
    vy_transit -.-> dead254
    erl_wan -.-> awsvpn
    erl_dead -.-> sw

    classDef risk fill:#fde8e8,stroke:#c0392b,stroke-width:2px,color:#7b241c
    classDef dead fill:#f4f4f4,stroke:#95a5a6,stroke-dasharray:4 3,color:#7f8c8d
    classDef router fill:#e8f0fe,stroke:#3b6ea5,color:#1b3a5c
    classDef net fill:#eaf7ef,stroke:#2e8b57,color:#1d5c39

    class erl_risk,vy_ctr,vy_fw risk
    class erl_dead,dead252,dead254,awsvpn dead
    class erl_wan,erl_lan,vy_transit,vy_stick router
    class sw,v910,v900,v610,v120,v550,v140,voff,eprt net
