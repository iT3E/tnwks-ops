        "homelab-wsl",
        "homelab-wsl-02"
      ],
      "databases": [
        "transcriber-pg"
      ],
      "tier": "warm",
      "fencing_required": true,
      "probe": {
        "url": "http://transcriber-app.production.svc.cluster.local:8081/api/healthz",
        "expect": "\"ok\":true"
      }
    },
    {
      "name": "changedetection",
