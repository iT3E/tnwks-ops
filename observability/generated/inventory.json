        "homelab-wsl",
        "homelab-wsl-02"
      ],
      "databases": [],
      "tier": "movable",
      "fencing_required": false,
      "probe": {
        "url": "http://changedetection.production.svc.cluster.local:5000/",
        "expect": "<html"
      }
