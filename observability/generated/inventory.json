{
  "version": 1,
  "sites": [
    {
      "id": "wsl",
      "cluster": "homelab-wsl",
      "probe_url": "http://prometheus-homelab-wsl.monitoring.svc.cluster.local:9090/-/ready",
      "router_peer": "wsl-site1",
      "tunnel": "wg-site1"
    },
    {
      "id": "wsl-02",
      "cluster": "homelab-wsl-02",
      "probe_url": "http://prometheus-homelab-wsl-02.monitoring.svc.cluster.local:9090/-/ready",
      "router_peer": "wsl-site2",
      "tunnel": "wg-site2"
    }
  ],
  "apps": [
    {
      "name": "mealie",
      "namespace": "production",
      "prefix": "MEALIE",
      "workloads": [
        "deployment/mealie"
      ],
      "clusters": [
        "homelab-wsl",
        "homelab-wsl-02"
      ],
      "databases": [
        "mealie-pg"
      ],
      "tier": "warm",
      "fencing_required": true,
      "probe": {
        "url": "http://mealie.production.svc.cluster.local:9000/api/app/about",
        "expect": "\"version\""
      }
    },
    {
      "name": "transcriber",
      "namespace": "production",
      "prefix": "TRANSCRIBER",
      "workloads": [
        "deployment/transcriber",
