{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'docker:enableMajor',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':enablePreCommit',
    'github>iT3E/tnwks-ops//.github/renovate/autoMerge.json5',
    'github>iT3E/tnwks-ops//.github/renovate/commitMessage.json5',
    'github>iT3E/tnwks-ops//.github/renovate/groups.json5',
    'github>iT3E/tnwks-ops//.github/renovate/labels.json5',
    'github>iT3E/tnwks-ops//.github/renovate/semanticCommits.json5',
    'helpers:pinGitHubActionDigests',
  ],
  ignorePresets: [
    'docker:pinDigests',
    ':maintainLockFilesWeekly',
  ],
  automergeType: 'pr',
  platformAutomerge: false,
  automergeStrategy: 'squash',
  ignoreTests: false,
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard 🤖',
    osvVulnerabilitySummary: 'all',
  },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    dependencyDashboardApproval: false,
  },
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  schedule: [
    'before 7am',
  ],
  prHourlyLimit: 4,
  prConcurrentLimit: 12,
  packageRules: [
    {
      description: 'Terraform providers and modules: 3 days after release',
      matchDatasources: [
        'terraform-provider',
        'terraform-module',
      ],
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'Terraform CLI: 3 days after release',
      matchPackageNames: [
        'hashicorp/terraform',
      ],
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'fireflyiii-mcp: 7 days after release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/daften/fireflyiii-mcp',
      ],
      minimumReleaseAge: '7 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'agentgateway: 7 days after release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/agentgateway/agentgateway',
      ],
      minimumReleaseAge: '7 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'Read MCP servers of main: 7 days after release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/containers/kubernetes_mcp_server',
        'ghcr.io/controlplaneio-fluxcd/flux-operator-mcp',
        'docker.io/hashicorp/terraform-mcp-server',
        'ghcr.io/github/github-mcp-server',
      ],
      minimumReleaseAge: '7 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'The host server of main: 7 days after release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/it3e/tnwks-host-mcp',
      ],
      minimumReleaseAge: '7 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'Firefly III: version- tags, 7 days after release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'fireflyiii/core',
        'docker.io/fireflyiii/core',
      ],
      versioning: 'regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      minimumReleaseAge: '7 days',
      internalChecksFilter: 'strict',
      prBodyNotes: [
        'Firefly III migrates its database on start. Before the merge, check a completed backup of firefly-pg newer than 24 hours, and read the release notes since the current version (docs/apps/firefly.md, "Image version" and "Restore").',
      ],
    },
    {
      description: 'peloton-to-garmin: console-v tags, 3 days after release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/philosowaffle/peloton-to-garmin',
      ],
      versioning: 'regex:^console-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'Coral: queue NumPy majors until its Windows runtime supports them',
      matchFileNames: [
        'infrastructure/ansible/roles/windows_coral_detector/**',
      ],
      matchPackageNames: [
        'numpy',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      dependencyDashboardCategory: 'Compatibility review',
      groupName: 'Coral NumPy compatibility',
      prBodyNotes: [
        'The Windows Coral runtime currently requires NumPy 1.x and Python 3.9. Review docs/operations/dependency-compatibility.md before approving this update. Security fixes bypass dashboard approval.',
      ],
    },
    {
      description: 'UniFi: queue MongoDB release-line changes until supported by the application',
      matchFileNames: [
        'kubernetes/apps/networking/unifi/**',
      ],
      matchPackageNames: [
        'docker.io/library/mongo',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      dependencyDashboardApproval: true,
      dependencyDashboardCategory: 'Compatibility review',
      groupName: 'UniFi MongoDB compatibility',
      prBodyNotes: [
        'Confirm the deployed UniFi application supports the proposed MongoDB release line; see docs/operations/dependency-compatibility.md. Compatible patch updates remain enabled.',
      ],
    },
    {
      description: 'Recheck MongoDB support whenever the UniFi image changes',
      matchFileNames: [
        'kubernetes/apps/networking/unifi/**',
      ],
      matchPackageNames: [
        'ghcr.io/linuxserver/unifi-network-application',
      ],
      prBodyNotes: [
        "Recheck UniFi's supported MongoDB versions and the pending MongoDB updates in the Dependency Dashboard. A weekly compatibility watch also tracks upstream documentation changes.",
      ],
    },
    {
      description: 'Open cloudflared updates ahead of everything else',
      matchPackageNames: [
        'docker.io/cloudflare/cloudflared',
      ],
      prPriority: 10,
    },
    {
      description: 'LiteLLM: release tags only',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/berriai/litellm',
      ],
      allowedVersions: '/^v\\d+\\.\\d+\\.\\d+$/',
    },
    {
      description: 'Container digest updates: open on Mondays',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      matchPackageNames: [
        '!/^ghcr\\.io\\/it3e\\//',
      ],
      schedule: [
        'before 7am on monday',
      ],
    },
    {
      description: 'The vendored manifests of the Wazuh server: a byte-for-byte copy, updated by hand (kubernetes/apps/security/wazuh/server/UPSTREAM.md)',
      matchFileNames: [
        'kubernetes/apps/security/wazuh/server/upstream/**',
      ],
      enabled: false,
    },
  ],
  'pre-commit': {
    enabled: true,
  },
  flux: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/ansible/.+\\.ya?ml(\\.j2)?$/',
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process generic # renovate: datasource=… depName=… version comments',
      managerFilePatterns: [
        '/ansible/.+\\.ya?ml(\\.j2)?$/',
        '/kubernetes/.+\\.ya?ml$/',
        '/^talos/.+\\.ya?ml$/',
        '/\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?\\n.*?["\']?(?<currentValue>[^"\'\\s]+)["\']?\\n',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Bump ?v= on Home Assistant Lovelace resources with their card version',
      managerFilePatterns: [
        '/kubernetes/apps/home-automation/home-assistant/app/config/configuration\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) cache-bust\\n\\s*- url: \\S+\\?v=(?<currentValue>[^\\s"\']+)\\n',
      ],
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      customType: 'regex',
      description: 'Image pins in observability/versions.py',
      managerFilePatterns: [
        '/^observability/versions\\.py$/',
      ],
      matchStrings: [
        '= "(?<depName>[a-z0-9./_-]+):(?<currentValue>[^@"]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
