{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Flux Group",
      "groupName": "Flux",
      "matchPackageNames": ["/flux/"],
      "matchDatasources": ["docker", "github-tags"],
      "versioning": "semver",
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": true
    },
    {
      // gotk-components.yaml is generated by `flux install --export` and only
      // changes as a whole (CRDs, RBAC, controller args and images together).
      // Bumping the controller images alone runs new controllers on old CRDs.
      // Flux upgrades come from the fluxcd/flux2 release PR instead, which
      // the reviewer regenerates the file for.
      "description": "No image-only bumps in the generated Flux manifest",
      "matchFileNames": ["kubernetes/clusters/**/flux-system/gotk-components.yaml"],
      "matchDatasources": ["docker"],
      "enabled": false
    },
    {
      // The ARC controller deletes any AutoscalingRunnerSet whose chart
      // major.minor differs from its own (IsVersionAllowed), in both
      // directions. Controller and scale sets must land in one commit.
      "description": "actions-runner-controller: controller and scale sets together",
      "groupName": "actions-runner-controller",
      "matchPackageNames": ["/gha-runner-scale-set/"]
    },
    {
      // Bumping bjw-s `app-template` is a fleet-wide schema change. Group
      // every chart bump into one PR so the canary→sweep migration can be
      // reviewed and merged as a single, cohesive change.
      "description": "bjw-s app-template fleet group",
      "groupName": "bjw-s app-template",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["app-template"],
      "separateMinorPatch": true
    },
    {
      // The KubernetesUpgrade (what tuppr rolls out) and the bootstrap pin in
      // talos/wsl/versions.yaml move together. Kubernetes only supports
      // upgrading one minor at a time, so each minor gets its own PR.
      "description": "Kubernetes version: one PR per minor, every pin together",
      "groupName": "Kubernetes",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet"],
      "separateMultipleMinor": true,
      "separateMinorPatch": true
    },
    {
      // WSL's node image pin and MS-01's TalosUpgrade move together. Talos
      // upgrades go one minor at a time (1.13 -> 1.14).
      "description": "Talos version: one PR per minor, every pin together",
      "groupName": "Talos",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/siderolabs/talos"],
      "separateMultipleMinor": true,
      "separateMinorPatch": true
    },
    {
      // Immich's server and machine-learning images are released together
      // and must run the same version. The render-config init container
      // reuses the server image, so it moves with them.
      "description": "Immich server and machine learning together",
      "groupName": "Immich",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ]
    }
  ]
}
