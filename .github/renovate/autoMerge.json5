{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Who merges what. Every update lands in one of three tiers, so nothing
  // sits untriaged:
  //   * automerge: Renovate merges the PR itself once every status check is
  //     green, including "Build Success" from .github/workflows/kubernetes.yaml
  //     (flate render + image exists). Flux error events page the War Room if
  //     a merged bump then fails to reconcile (flux-system/addons/alerts).
  //   * impact/high: never automerged. renovate-review.yaml hands these to
  //     Ori's reviewer agent, which does whatever migration the bump needs,
  //     merges, verifies live, and reverts if the check fails.
  //   * impact/critical (on top of impact/high): a bad merge can't be undone
  //     by reverting the PR. Data formats, the cluster's own version, the
  //     CNI, and Flux itself. The agent prepares these the same way but only
  //     merges after Ivan adds ivan/approved (docs/operations/renovate.md).
  //     The agent also adds this label itself when a review turns up an
  //     irreversible step; it never removes it.
  // Rules are evaluated in order and later rules win, so the review blocks at
  // the bottom override any automerge rule above them. addLabels accumulate.
  packageRules: [
    // ---------------------------------------------------------------- automerge
    {
      description: "App images and charts: patch and digest updates",
      matchFileNames: [
        "kubernetes/apps/ai/**",
        "kubernetes/apps/cache/**",
        "kubernetes/apps/default/**",
        "kubernetes/apps/home-automation/**",
        "kubernetes/apps/media/**",
        "kubernetes/apps/monitoring/**",
        "kubernetes/apps/production/**",
        "kubernetes/apps/selfhosted/**",
      ],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    {
      // 0.x minors can break at any time (zer0ver), so they stay manual.
      description: "App images and charts: minor updates, outside 0.x, weekly",
      matchFileNames: [
        "kubernetes/apps/ai/**",
        "kubernetes/apps/cache/**",
        "kubernetes/apps/default/**",
        "kubernetes/apps/home-automation/**",
        "kubernetes/apps/media/**",
        "kubernetes/apps/monitoring/**",
        "kubernetes/apps/production/**",
        "kubernetes/apps/selfhosted/**",
      ],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
      schedule: ["before 7am on monday"],
    },
    {
      description: "GitHub Actions: minor, patch and digest, 3 days after release",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      automerge: true,
    },
    {
      description: "GitHub's own actions/*: no wait",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: null,
      automerge: true,
    },
    {
      description: "CI tools pinned in workflows (# renovate: comments): minor and patch",
      matchFileNames: [".github/workflows/**"],
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      // requirements.yml only; nothing runs Ansible automatically.
      description: "Ansible collections and roles: minor and patch",
      matchDatasources: ["galaxy", "galaxy-collection"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "pre-commit hooks: minor, patch and digest",
      matchManagers: ["pre-commit"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },

    // -------------------------------------------------------------- impact/high
    {
      // Everything outside the automerge paths: cluster plumbing (CNI, load
      // balancer, ingress, DNS, certs, storage, databases, auth, Flux, the
      // runner controller), Talos, Terraform, and anything new. Negated-only
      // patterns match every file that none of them match.
      description: "Platform and everything else: always reviewed",
      matchFileNames: [
        "!kubernetes/apps/ai/**",
        "!kubernetes/apps/cache/**",
        "!kubernetes/apps/default/**",
        "!kubernetes/apps/home-automation/**",
        "!kubernetes/apps/media/**",
        "!kubernetes/apps/monitoring/**",
        "!kubernetes/apps/production/**",
        "!kubernetes/apps/selfhosted/**",
        "!.github/workflows/**",
        "!infrastructure/ansible/requirements.yml",
        "!.pre-commit-config.yaml",
        "!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//",
      ],
      automerge: false,
      addLabels: ["impact/high"],
    },
    {
      description: "Platform packages wherever they are referenced",
      matchPackageNames: [
        "/app-template/",
        "/kube-prometheus-stack/",
        "/fluxcd/",
        "/siderolabs/",
        "/cloudnative-pg/",
        "/rook/",
      ],
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high"],
    },
    {
      // AWS applies on merge (terraform-apply.yaml); every bump needs a plan.
      description: "Terraform: always reviewed",
      matchManagers: ["terraform"],
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high"],
    },
    {
      description: "Majors: always reviewed",
      matchUpdateTypes: ["major"],
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high"],
    },
    {
      // Their "minor" is often a monthly release with on-disk format changes
      // (ClickHouse 24.3 -> 24.12) or a breaking-changes release (Home
      // Assistant 2026.10 -> 2026.11), and a bad one loses data or the house,
      // not just uptime.
      description: "Databases, stateful stores, calendar-versioned apps: minors reviewed",
      matchPackageNames: [
        "/clickhouse/",
        "/postgres/",
        "/couchdb/",
        "/mariadb/",
        "/mysql/",
        "/mongo/",
        "/valkey/",
        "/redis/",
        "/mosquitto/",
        "/vaultwarden/",
        "/home-assistant/",
      ],
      matchUpdateTypes: ["minor"],
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high"],
    },
    {
      description: "0.x minors: always reviewed",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high"],
    },
    // ---------------------------------------------------------- impact/critical
    {
      // If Flux breaks, git can't roll it back: nothing is left to apply the
      // revert. gotk-components.yaml is generated by `flux install --export`.
      description: "Flux itself: Ivan approves",
      matchFileNames: ["kubernetes/clusters/**/flux-system/**", "!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high", "impact/critical"],
    },
    {
      description: "Flux CLI/release: Ivan approves",
      matchPackageNames: ["/fluxcd\\/flux2/"],
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high", "impact/critical"],
    },
    {
      // Kubernetes and Talos versions only move forward (etcd and API
      // storage versions migrate on upgrade).
      description: "Cluster version (Talos, Kubernetes): Ivan approves",
      matchPackageNames: [
        "/siderolabs/",
        "/^kubernetes\\/kubernetes$/",
        "/registry\\.k8s\\.io\\/kube-(apiserver|controller-manager|scheduler|proxy)/",
        "/kubelet/",
      ],
      // Legacy Ansible templates (k3s era) aren't applied by anything.
      matchFileNames: ["!infrastructure/ansible/**", "!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      matchUpdateTypes: ["major", "minor"],
      automerge: false,
      addLabels: ["impact/high", "impact/critical"],
    },
    {
      // A broken pod network also cuts Flux off from its own source.
      description: "CNI majors and minors: Ivan approves",
      matchPackageNames: ["/flannel/", "/cilium/"],
      // Legacy Ansible templates (k3s era) aren't applied by anything.
      matchFileNames: ["!infrastructure/ansible/**", "!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      matchUpdateTypes: ["major", "minor"],
      automerge: false,
      addLabels: ["impact/high", "impact/critical"],
    },
    {
      // Majors of data stores rewrite their on-disk format. Going back means
      // restoring a backup, not reverting a PR.
      description: "Data store and storage majors: Ivan approves",
      matchPackageNames: [
        "/clickhouse/",
        "/postgres/",
        "/postgis/",
        "/cloudnative-pg/",
        "/couchdb/",
        "/mariadb/",
        "/mysql/",
        "/mongo/",
        "/valkey/",
        "/redis/",
        "/vaultwarden/",
        "/home-assistant/",
        "/ceph/",
        "/rook/",
      ],
      matchUpdateTypes: ["major"],
      matchFileNames: ["!/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: false,
      addLabels: ["impact/high", "impact/critical"],
    },
    // --------------------------------------------------------------- MS-01 only
    {
      // MS-01 isn't built yet, so nothing live reads these paths. Keep them
      // current behind Build Success instead of queueing reviews. Every
      // review rule above negates the same regex, so these updates never get
      // an impact/* label. Remove this rule (and the negations) when MS-01
      // goes live. Paths come from what kubernetes/clusters/ms-01 reaches and
      // kubernetes/clusters/wsl doesn't; a grouped update that also touches a
      // WSL file still needs every upgrade to automerge, so it stays reviewed.
      description: "MS-01-only manifests and Talos config: automerge while MS-01 isn't live",
      matchFileNames: ["/^(talos/ms-01|kubernetes/clusters/ms-01|kubernetes/apps/(kube-system/cilium|monitoring/thanos|monitoring/vector/agent|production/uisp|storage/rook-ceph|tools/node-feature-discovery|databases/cloudnative-pg/cluster-backup))//"],
      automerge: true,
    },
  ],
}
